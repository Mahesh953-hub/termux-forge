#!/data/data/com.termux/files/usr/bin/bash
# tfart — pick and apply your Termux login-banner art.
# fzf-based: arrows move, live preview, Enter selects, Esc cancels.
# Used standalone and by termux-forge's banner step.

ART_DIR="$HOME/.termux/ascii"
TARGET="$HOME/.termux/ascii_art.txt"
mkdir -p "$ART_DIR"

G=$'\033[1;32m'; R=$'\033[1;31m'; Y=$'\033[1;33m'; C=$'\033[1;36m'; D=$'\033[2m'; N=$'\033[0m'

builtin_art() {
  case "$1" in
    "Termux T logo") cat <<'A'
  _____                   _  __
 |_   _|__ _ __ _   _  _| |/ /
   | |/ _ \ '__| | | | | | ' /
   | |  __/ |  | |_| | | | . \
   |_|\___|_|   \__,_| |_|_|\_\
A
      ;;
    "Rocket") cat <<'A'
      /\
     /  \
    / /\ \
   / /  \ \
  /_/    \_\
A
      ;;
    "Cat") cat <<'A'
   /\_/\
  ( o.o )
   > ^ <
A
      ;;
    "Skull") cat <<'A'
   ____  ____  ____
 |  _ \/ ___||___ \
 | |_) \___ \ __) |
 |  __/ ___) | __/
 |_|   |____/|_____|
A
      ;;
  esac
}

art_body() {
  local n="$1"
  case "$n" in
    "Termux T logo"|Rocket|Cat|Skull) builtin_art "$n" ;;
    *) [[ -f "$ART_DIR/$n.txt" ]] && cat "$ART_DIR/$n.txt" ;;
  esac
}

# fzf calls this to draw the preview pane.
if [[ "${1:-}" == "--preview" ]]; then
  name="$2"
  if [[ "$name" == "None" ]]; then
    echo -e "${D}(no art)${N}"
  else
    art_body "$name"
  fi
  exit 0
fi

list_arts() {
  printf '%s\n' "Termux T logo" Rocket Cat Skull
  local f
  for f in "$ART_DIR"/*.txt; do
    [[ -f "$f" ]] && basename "$f" .txt
  done
  printf '%s\n' None
}

apply_art() {
  local n="$1"
  if [[ "$n" == "None" ]]; then
    rm -f "$TARGET"
  else
    art_body "$n" > "$TARGET"
  fi
  [[ -f "$TARGET" ]] && cp "$TARGET" "$HOME/.termux/current_art.txt" 2>/dev/null
}

pick_art() {
  local prompt="${1:-Select banner art:}"
  list_arts | fzf \
    --prompt="$prompt " \
    --header="↑↓ move · enter select · esc cancel" \
    --height=100% --layout=reverse --border=none \
    --preview "$0 --preview {}" \
    --preview-window='right:45%:wrap:nowrap' \
    --no-multi --no-sort
}

case "${1:-}" in
  -a|--add)
    [[ -z "${2:-}" ]] && { echo -e "${R}Usage: tfart -a <name>${N}"; exit 1; }
    echo -e "${C}Paste your ASCII below, then hit Ctrl+D:${N}"
    cat > "$ART_DIR/$2.txt"
    echo -e "${G}✔ Added '$2' to arsenal.${N}"
    exit 0
    ;;
  -rm|--remove)
    picked="$(ls "$ART_DIR" 2>/dev/null | sed 's/\.txt$//' | fzf \
      --prompt="Remove which art? " \
      --header="↑↓ move · enter select · esc cancel" \
      --height=60% --layout=reverse --border=none --no-multi)" || {
      echo -e "${D}aborted${N}"; exit 1; }
    [[ -z "$picked" ]] && exit 1
    rm -f "$ART_DIR/$picked.txt"
    echo -e "${R}! $picked deleted.${N}"
    exit 0
    ;;
esac

sel="$(pick_art)" || { echo -e "${D}aborted${N}"; exit 1; }
[[ -z "$sel" ]] && { echo -e "${D}aborted${N}"; exit 1; }

apply_art "$sel"
clear
echo -e "${G}✔ Banner art set: ${N}$sel\n"
[[ -f "$HOME/motd.sh" ]] && bash "$HOME/motd.sh" 2>/dev/null
