#!/data/data/com.termux/files/usr/bin/bash
#
# termux-forge — a rich, interactive, resumable Termux setup installer.
#
# Note: Termux has no /usr/bin/env, so the shebang uses the absolute bash path.
#
# Installs zsh + packages, oh-my-zsh + plugins, powerlevel10k, fonts, colors,
# keyboard layout, theme, hostname, banner, prompt, an optimized .zshrc,
# speedups and daily-use polish. Every step is intentional and skippable,
# and anything destructive is opt-in.
#
# Usage:
#   ./termux-forge                 interactive run
#   ./termux-forge --list          list all steps and exit
#   ./termux-forge --dry-run       print commands, change nothing
#   ./termux-forge --verbose       show the full step list at each step
#   ./termux-forge --yes           accept every step without asking
#   ./termux-forge --no            skip every step without asking
#   ./termux-forge --only a,b,c    run only these step ids
#   ./termux-forge --skip a,b,c    skip these step ids
#   ./termux-forge --force         re-run steps already marked done
#   ./termux-forge --opt-in        include the destructive steps (cleanup, repair)
#   ./termux-forge --reset         wipe the saved session, keep backups
#   ./termux-forge --flush         delete ALL backups + logs + state, start fresh
#   ./termux-forge --state-dir D   use a different state directory
#   ./termux-forge --backup-dir D  use a different backup directory
#   ./termux-forge --log-dir D     use a different log directory
#   ./termux-forge --help          this text
#

set -o pipefail

# --------------------------------------------------------------------------
# Config
# --------------------------------------------------------------------------
readonly VERSION="2.0.0"
# Resolve through symlinks so a `tf` link in $PREFIX/bin still finds ./commands
_tf_self="${BASH_SOURCE[0]}"
while [[ -L "$_tf_self" ]]; do
  _tf_link="$(readlink "$_tf_self")"
  [[ "$_tf_link" == /* ]] && _tf_self="$_tf_link" || _tf_self="$(cd "$(dirname "$_tf_self")" && pwd)/$_tf_link"
done
SCRIPT_DIR="$(cd "$(dirname "$_tf_self")" && pwd)"
STATE_DIR="${TERMUX_FORGE_STATE:-$HOME/termux-forge/state}"
BACKUP_DIR="${TERMUX_FORGE_BACKUP:-$HOME/termux-forge/backups}"
LOG_DIR="${TERMUX_FORGE_LOG:-$HOME/termux-forge/logs}"
LOG_FILE="$LOG_DIR/termux-forge-$(date +%Y%m%d_%H%M%S).log"

# --------------------------------------------------------------------------
# Palette
# --------------------------------------------------------------------------
declare -A C=(
  [reset]=$'\033[0m'  [bold]=$'\033[1m'   [dim]=$'\033[2m'
  [red]=$'\033[31m'   [green]=$'\033[32m'  [yellow]=$'\033[33m'
  [blue]=$'\033[34m'  [magenta]=$'\033[35m' [cyan]=$'\033[36m'
  [white]=$'\033[37m' [orange]=$'\033[38;5;208m'
  [bg]=$'\033[48;5;236m'
)
if [[ -t 1 ]]; then
  C[reset]=$'\033[0m'; C[bold]=$'\033[1m'; C[dim]=$'\033[2m'
  C[red]=$'\033[31m'; C[green]=$'\033[32m'; C[yellow]=$'\033[33m'
  C[blue]=$'\033[34m'; C[magenta]=$'\033[35m'; C[cyan]=$'\033[36m'
  C[white]=$'\033[37m'; C[orange]=$'\033[38;5;208m'
fi

# --------------------------------------------------------------------------
# Flags
# --------------------------------------------------------------------------
DRY_RUN=0; YES=0; NO=0; FORCE=0; LIST=0; RESET=0; FLUSH=0; TF_QUIT=0; OPT_IN=0; VERBOSE=0
ONLY_LIST=""; SKIP_LIST=""

# Anything that grabs the terminal must hand it back. Without this, an
# interrupted run leaves mouse reporting and bracketed paste switched on, and
# the symptom is "I can't select or paste anything any more" long after tf is
# gone. Cheap insurance, no downside.
tf_restore_tty() {
  [[ -t 1 ]] || return 0
  printf '\033[?1000l\033[?1002l\033[?1003l\033[?1005l\033[?1006l\033[?1015l'  # mouse off
  printf '\033[?2004l'                                                          # bracketed paste off
  printf '\033[?1049l'                                                          # leave alt screen
  printf '\033[?25h'                                                            # cursor back
  stty sane 2>/dev/null || true
}
trap tf_restore_tty EXIT
trap 'tf_restore_tty; exit 130' INT
trap 'tf_restore_tty; exit 143' TERM

usage() { sed -n '2,/^$/p' "$_tf_self" | sed 's/^# \{0,1\}//'; exit 0; }

while (($#)); do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --opt-in)  OPT_IN=1 ;;
    --verbose) VERBOSE=1 ;;
    --yes)     YES=1 ;;
    --no)      NO=1 ;;
    --force)   FORCE=1 ;;
    --list)    LIST=1 ;;
    --reset)   RESET=1 ;;
    --flush)   FLUSH=1 ;;
    --only)    ONLY_LIST="${2// /}"; shift ;;
    --skip)    SKIP_LIST="${2// /}"; shift ;;
    --state-dir) STATE_DIR="$2"; shift ;;
    --backup-dir) BACKUP_DIR="$2"; shift ;;
    --log-dir) LOG_DIR="$2"; shift ;;
    -h|--help) usage ;;
    *) echo "unknown arg: $1" >&2; usage ;;
  esac
  shift
done

mkdir -p "$STATE_DIR" "$BACKUP_DIR" "$LOG_DIR"
LOG_FILE="$LOG_DIR/termux-forge-$(date +%Y%m%d_%H%M%S).log"
exec > >(tee -a "$LOG_FILE") 2>&1

# --------------------------------------------------------------------------
# UI helpers
# --------------------------------------------------------------------------
# Rules built once. `$(printf '-.0s' {1..N})` inside a function forks a subshell
# on every divider, which adds up fast on a phone.
RULE58=""
for ((_i=0; _i<58; _i++)); do RULE58+="-"; done
RULE17=""
for ((_i=0; _i<17; _i++)); do RULE17+="-"; done
unset _i

hr()      { printf '%s%s%s\n' "${C[dim]}" "$RULE58" "${C[reset]}"; }
box_top() { :; }
box_bot() { :; }

# ---- brand --------------------------------------------------------------
TF_TAG='╔▚╗'
tf_logo() {
  # 17-col block monogram, coloured per row: reads as a brand, not decoration
  local rows=(
    "████████╗███████╗"
    "██╔════╝██╔════╝"
    "███████╗█████╗"
    "╚════██║██╔══╝"
    " ╚═════╝╚═╝"
  )
  local cols=("${C[cyan]}" "${C[green]}" "${C[cyan]}" "${C[blue]}" "${C[reset]}")
  local i
  for ((i = 0; i < 5; i++)); do
    printf '%s%s%s %s\n' "${cols[$i]}" "${rows[$i]}" "${C[reset]}"
  done
}

header() {
  clear
  local i rows cols
  rows=("████████╗███████╗" "██╔════╝██╔════╝" "███████╗█████╗" "╚════██║██╔══╝" " ╚═════╝╚═╝")
  cols=("${C[cyan]}" "${C[green]}" "${C[cyan]}" "${C[blue]}" "${C[dim]}")
  printf '\n'
  printf '   %s▄▄▄%s  %s%sTERMUX FORGE%s   %s%s%s\n' \
    "${C[dim]}" "${C[reset]}" "${C[bold]}${C[green]}" "${C[reset]}" "${C[dim]}" "v$VERSION" "${C[reset]}"
  for ((i = 0; i < 5; i++)); do
    printf '   %s%s%s\n' "${cols[$i]}" "${rows[$i]}" "${C[reset]}"
  done
  printf '\n   %s%s%s\n' "${C[dim]}" "$RULE17" "${C[reset]}"
  printf '   %sinteractive termux setup%s %s· %s%d steps%s\n\n' \
    "${C[dim]}" "${C[reset]}" "${C[dim]}" "${C[cyan]}" "${#STEPS[@]}" "${C[reset]}"
}

section() {
  local id="$1" title="$2"
  echo
  printf '  %s%s%s %s▚%s %s%s%s %s%s%s\n' \
    "${C[cyan]}" "--" "${C[reset]}" \
    "${C[dim]}" "${C[reset]}" "${C[bold]}${C[yellow]}" "$id" "${C[reset]}" \
    "${C[bold]}" "$title" "${C[reset]}"
}

step_rule() {
  printf '\n  %b%s%b\n' "\033[38;5;${STEP_HUE}m" "$RULE58" '\033[0m'
}

step_clear() {
  # Don't clear the very first step: the brand header was just drawn and there
  # is nothing above it worth discarding yet.
  STEP_SEEN=$(( ${STEP_SEEN:-0} + 1 ))
  if (( STEP_SEEN > 1 )) && [[ -t 1 && "$DRY_RUN" -eq 0 ]]; then
    printf '\033[H\033[2J\033[3J'
  fi
  return 0
}

# Full card, shown only when the runner has to ask. Clears first, so the screen
# holds exactly one step instead of stacking twenty screens of history.
step_confirm_card() {
  local id="$1"
  step_clear
  step_rule
  printf '  \033[38;5;%sm%s%s%s%s  %s%s%s   %s%d%s/%s%d%s\n' \
    "$STEP_HUE" "${C[bold]}" "$id" "${C[reset]}" "" \
    "${C[bold]}" "${STEP_NAME[$id]}" "${C[reset]}" \
    "${C[dim]}" "$STEP_IDX" "${C[reset]}" "${C[dim]}" "${#STEPS[@]}" "${C[reset]}"
  printf '  %s%s\n' "${C[dim]}" "$RULE58" "${C[reset]}"
  wrap "${STEP_DESC[$id]}" 4
  printf '\n'
  wrap "${STEP_EXPLAIN[$id]}" 4
  printf '\n  %srisk%s %s%s%s\n' "${C[dim]}" "${C[reset]}" \
    "${C[orange]}" "${STEP_RISK[$id]}" "${C[reset]}"
  step_rule
}

# Quiet banner. When the user already named the step (--only / --force) there is
# nothing to sell, so no paragraph and no re-prompt.
step_head() {
  local id="$1"
  step_clear
  step_rule
  printf '  \033[38;5;%sm%s%s%s%s  %s%s%s  %s%d/%d%s\n' \
    "$STEP_HUE" "${C[bold]}" $'\u2588' "$id" "${C[reset]}" \
    "${STEP_NAME[$id]}" "${C[reset]}" "${C[dim]}" "$STEP_IDX" "${#STEPS[@]}" "${C[reset]}"
  step_rule
}

info() { printf '  %s›%s %s\n' "${C[blue]}" "${C[reset]}" "$*"; }
ok()   { printf '  %s✓%s %s\n' "${C[green]}" "${C[reset]}" "$*"; }
warn() { printf '  %s!%s %s\n' "${C[orange]}" "${C[reset]}" "$*"; }
err()  { printf '  %s✗%s %s\n' "${C[red]}" "${C[reset]}" "$*"; }

wrap() {
  local text="$1" width="${2:-58}" line=""
  local word
  for word in $text; do
    if ((${#line} + ${#word} + 1 > width)); then
      printf '  %s%s%s\n' "${C[dim]}" "$line" "${C[reset]}"
      line="$word"
    else
      line="${line:+$line }$word"
    fi
  done
  [[ -n "$line" ]] && printf '  %s%s%s\n' "${C[dim]}" "$line" "${C[reset]}"
}

# --------------------------------------------------------------------------
# Picker: fzf-based (arrow keys + live preview, no hand-rolled redraw)
# --------------------------------------------------------------------------
# tf_pick <title> <mode> <start_index> <opt1> <opt2> ...
#   mode = none | art | style
# Sets $MENU_CHOICE (1-based). Returns 1 if cancelled.
tf_pick() {
  local title="$1" mode="$2" start="${3:-1}"
  shift 3
  local -a opts=("$@")
  local n=${#opts[@]}
  (( n == 0 )) && return 1
  (( start < 1 || start > n )) && start=1

  command -v fzf >/dev/null 2>&1 || {
    err "fzf not found — install it with: pkg install fzf"
    return 1
  }

  # Common fzf flags; --preview is added per mode.
  # --no-mouse matters more than it looks: fzf grabs the mouse by default, and
  # while it holds it you cannot select text with the finger, so nothing in the
  # preview pane can be copied out.
  local -a fz=(--prompt="$title " --header="up/down move - enter select - esc cancel"
               --layout=reverse --border=none --no-multi --no-sort --no-mouse)

  local selected="" pv="" pw="down:12%:wrap:nowrap" h=60
  case "$mode" in
    art)
      pv="$SCRIPT_DIR/commands/tfart --preview {}"
      pw="right:45%:wrap:nowrap"; h=100
      ;;
    style)
      pv="$SCRIPT_DIR/commands/tf-style-preview {}"
      ;;
    font)
      pv="$SCRIPT_DIR/commands/tf-font-preview {}"
      pw="right:40%:wrap:nowrap"; h=60
      ;;
    anim)
      # one static frame of the animation, big, so it previews at all
      pv="TFLOOP_FRAMES=6 $SCRIPT_DIR/commands/tfloop --frame {}"
      pw="right:50%:wrap:nowrap"; h=100
      ;;
    prompt)
      pv="$SCRIPT_DIR/commands/tf-prompt-preview {}"
      pw="right:52%:wrap:nowrap"; h=100
      ;;
    theme)
      pv="$SCRIPT_DIR/commands/tf-theme-preview {}"
      pw="right:52%:wrap:nowrap"; h=100
      ;;
    keys)
      pv="$SCRIPT_DIR/commands/tf-keys-preview {}"
      pw="down:55%:wrap:nowrap"
      ;;
  esac

  local -a cmd=(fzf)
  [[ -n "$pv" ]] && cmd+=(--preview "$pv" --preview-window="$pw")
  cmd+=("${fz[@]}" --height="$h")

  selected="$(printf '%s\n' "${opts[@]}" | "${cmd[@]}")" || return 1

  [[ -z "$selected" ]] && return 1
  local i
  for ((i = 0; i < n; i++)); do
    if [[ "${opts[$i]}" == "$selected" ]]; then
      MENU_CHOICE=$((i + 1))
      return 0
    fi
  done
  return 1
}

tf_full_preview() {
  local title="$1"
  shift
  clear
  printf '%s╔══════════════════════════════════════════╗%s\n' "${C[cyan]}" "${C[reset]}"
  printf '%s║%s  %s%s%s  %s║%s\n' "${C[cyan]}" "${C[reset]}" "${C[bold]}${C[green]}" "$title" "${C[reset]}" "${C[cyan]}" "${C[reset]}"
  printf '%s╚══════════════════════════════════════════╝%s\n' "${C[cyan]}" "${C[reset]}"
  "$@" | sed 's/^/  /'
}

# --------------------------------------------------------------------------
ask_yn() {
  local q="$1" def="${2:-N}" alt k rest ans
  alt="$([[ $def == [Yy] ]] && echo N || echo Y)"
  while :; do
    printf '  %s▏%s %s %s[%s/%s/q]%s ' \
      "${C[yellow]}" "${C[reset]}" "$q" "${C[dim]}" "$def" "$alt" "${C[reset]}"
    # one keypress answers immediately (no Enter). Anything that is not a bare
    # y/n/q is treated as a pasted line, so "yes<Enter>" still works.
    if IFS= read -rsn1 -t 10 -u 0 k 2>/dev/null; then
      case "$k" in
        [Yy]) return 0 ;;
        [Nn]) return 1 ;;
        [Qq]) printf '\n'; TF_QUIT=1; return 2 ;;
        $'\n'|$'\r') return $([[ $def == [Yy] ]] && printf 0 || printf 1) ;;
        *)
          rest=""
          while IFS= read -rsn1 -t 0.4 -u 0 k2 2>/dev/null; do rest+="$k2"; done
          ans="${k}${rest}"
          printf '\n'
          case "${ans//[[:space:]]/}" in
            [Yy]*) return 0 ;;
            [Nn]*) return 1 ;;
            [Qq]*) TF_QUIT=1; return 2 ;;
            *) err "answer y, n or q — got '$ans'" ;;
          esac ;;
      esac
    else
      # timeout or stdin closed: fall back to the default rather than hang
      printf '\n'
      if [[ -t 0 ]]; then err "timed out — taking [$def]"; fi
      return $([[ $def == [Yy] ]] && printf 0 || printf 1)
    fi
  done
}

# ask_input <prompt> [default] — echoes the answer on stdout.
ask_input() {
  local prompt="$1" def="${2:-}" ans
  printf '  %s?%s %s%s: ' "${C[cyan]}" "${C[reset]}" "$prompt" "${def:+ [$def]}" >&2
  IFS= read -r ans
  printf '%s' "${ans:-$def}"
}

ask_menu() {
  local prompt="$1" default="$2"; shift 2
  local opts=("$@") i ans
  printf '\n  %s%s%s\n' "${C[bold]}" "$prompt" "${C[reset]}"
  for i in "${!opts[@]}"; do
    printf '    %s%d)%s %s\n' "${C[cyan]}" "$((i + 1))" "${C[reset]}" "${opts[$i]}"
  done
  while :; do
    printf '  %s?%s choice [%s]: ' "${C[yellow]}" "${C[reset]}" "$default"
    IFS= read -r ans
    ans="${ans:-$default}"
    if [[ "$ans" =~ ^[0-9]+$ ]] && ((ans >= 1 && ans <= ${#opts[@]})); then
      MENU_CHOICE="$ans"
      return 0
    fi
    err "enter a number between 1 and ${#opts[@]}"
  done
}

# --------------------------------------------------------------------------
# Exec / state / backup
# --------------------------------------------------------------------------
run() {
  local cmd="$*" rc
  if ((DRY_RUN)); then
    printf '  %s$%s %s\n' "${C[dim]}" "${C[reset]}" "$cmd"
    return 0
  fi
  # stream output (interactive commands must not be captured) but never let a
  # failure pass silently — name the command and its exit code
  eval "$cmd"; rc=$?
  (( rc )) && err "exit $rc — $cmd"
  return $rc
}

# sed -i that respects --dry-run. Wrapper exists so call sites keep their
# single-quoted sed script instead of fighting run()'s double-quoted eval.
fsed() {
  if ((DRY_RUN)); then
    printf '  %s$%s sed -i %s\n' "${C[dim]}" "${C[reset]}" "$*"
    return 0
  fi
  sed -i "$@"
}

emit() {
  local dest="$1"
  if ((DRY_RUN)); then
    printf '  %s$%s write %s\n' "${C[dim]}" "${C[reset]}" "$dest"
    return 0
  fi
  cat > "$dest"
}

pkg_install() {
  info "installing: $*"
  run "pkg install -y $*"
}

git_clone() {
  local url="$1" dir="$2"
  if [[ -d "$dir/.git" ]]; then
    info "already cloned: $dir"
    return 0
  fi
  run "git clone --depth 1 '$url' '$dir'"
}

state_set() { printf '%s=%s\n' "$1" "$2" >> "$STATE_DIR/session"; }
state_get() {
  [[ -f "$STATE_DIR/session" ]] || return 1
  grep "^$1=" "$STATE_DIR/session" 2>/dev/null | tail -1 | cut -d= -f2-
}

backup() {
  local name="$1"; shift
  local ts dir f
  ts="$(date +%Y%m%d_%H%M%S)"
  dir="$BACKUP_DIR/${name}-${ts}"
  if ((DRY_RUN)); then
    printf '  %s$%s backup %s -> %s.tar.gz\n' "${C[dim]}" "${C[reset]}" "$name" "$dir"
    return 0
  fi
  mkdir -p "$dir"
  for f in "$@"; do
    [[ -e "$f" ]] && cp -a "$f" "$dir/" 2>/dev/null
  done
  ( cd "$dir" && tar czf "${dir}.tar.gz" . >/dev/null 2>&1 && rm -rf "$dir" )
  ok "backed up -> ${dir}.tar.gz"
}

# --------------------------------------------------------------------------
# Step registry
# --------------------------------------------------------------------------
STEPS=(
  preflight backup packages zsh omz plugins p10k
  fonts colors keyboard theme hostname banner zshrc speedup prompt polish cleanup repair commands finish
)

declare -A STEP_NAME STEP_DESC STEP_EXPLAIN STEP_RISK

STEP_NAME[preflight]="Preflight checks"
STEP_DESC[preflight]="Verify Termux environment, architecture, storage access and network."
STEP_EXPLAIN[preflight]="Confirms we are inside Termux, that pkg works, that storage permission is granted and that the network is reachable. Nothing is installed or changed."
STEP_RISK[preflight]="none — read only."

STEP_NAME[backup]="Backup existing config"
STEP_DESC[backup]="Snapshot your current dotfiles and Termux settings before touching anything."
STEP_EXPLAIN[backup]="Creates a timestamped tar.gz in backups/ containing .zshrc, .zshenv, .p10k.zsh, .bashrc, .nanorc, .termux/, motd.sh, ninja.sh and the fastfetch config. If anything goes wrong you can restore from here."
STEP_RISK[backup]="none — only copies files."

STEP_NAME[packages]="Install packages"
STEP_DESC[packages]="Install zsh and the core CLI tools via pkg."
STEP_EXPLAIN[packages]="Installs: zsh git curl wget ripgrep fzf fd bat eza zoxide atuin neovim fastfetch jq python3 ncurses-utils openssl dialog tar unzip. These are the dependencies every later step relies on."
STEP_RISK[packages]="low — standard Termux packages from the official repo."

STEP_NAME[zsh]="Set zsh as login shell"
STEP_DESC[zsh]="Make zsh your default shell."
STEP_EXPLAIN[zsh]="Runs chsh -s zsh so every new Termux session starts zsh instead of bash. You can revert with chsh -s bash."
STEP_RISK[zsh]="low — changes your login shell."

STEP_NAME[omz]="Install oh-my-zsh"
STEP_DESC[omz]="Install the oh-my-zsh framework."
STEP_EXPLAIN[omz]="Clones oh-my-zsh into ~/.oh-my-zsh and runs its unattended installer, which writes a default .zshrc. Your existing .zshrc is backed up first. oh-my-zsh gives you a plugin system, themes and sensible defaults."
STEP_RISK[omz]="medium — overwrites ~/.zshrc (backed up first)."

STEP_NAME[plugins]="Install plugins"
STEP_DESC[plugins]="Pick and install oh-my-zsh plugins, one by one."
STEP_EXPLAIN[plugins]="Walks through a curated list of plugins. For each one you get a plain-English explanation of what it does and what it costs, then you choose to install or skip. External plugins are cloned into ~/.oh-my-zsh/custom/plugins; built-in ones are just enabled."
STEP_RISK[plugins]="low — each plugin is optional and reversible."

STEP_NAME[p10k]="Install powerlevel10k"
STEP_DESC[p10k]="Install and configure the powerlevel10k prompt theme."
STEP_EXPLAIN[p10k]="Clones powerlevel10k into the oh-my-zsh custom themes folder and writes a tuned .p10k.zsh preset (nerd fonts, clean segments, instant prompt). You can also launch the interactive p10k configure wizard afterwards."
STEP_RISK[p10k]="low — theme only, no system changes."

STEP_NAME[fonts]="Install a nerd font"
STEP_DESC[fonts]="Choose and install a patched nerd font for icons and glyphs."
STEP_EXPLAIN[fonts]="Nerd fonts add the icons powerlevel10k and eza use. Downloads the latest release into ~/.fonts, copies the Regular variant to ~/.termux/font.ttf and reloads Termux settings. If termux-nf is present it is used; otherwise we download directly."
STEP_RISK[fonts]="low — only touches ~/.fonts and ~/.termux/font.ttf."

STEP_NAME[colors]="Choose a color scheme"
STEP_DESC[colors]="Pick a terminal color palette and apply it."
STEP_EXPLAIN[colors]="Writes ~/.termux/colors.properties with a 16-color palette (background, foreground, cursor and 16 ANSI colors) then reloads Termux. You can pick from curated schemes or launch the termux-color TUI if it is installed."
STEP_RISK[colors]="low — only touches ~/.termux/colors.properties."

STEP_NAME[keyboard]="Customize the keyboard"
STEP_DESC[keyboard]="Choose an extra-keys layout for the Termux keyboard."
STEP_EXPLAIN[keyboard]="Writes ~/.termux/termux.properties with an extra-keys row (ESC, CTRL, ALT, TAB, arrows, HOME/END, DELETE, PGUP/PGDN) plus session shortcuts, then reloads Termux. Pick a layout that matches how you type."
STEP_RISK[keyboard]="low — only touches ~/.termux/termux.properties."

STEP_NAME[banner]="Configure the banner"
STEP_DESC[banner]="Set your username and a login banner / motd."
STEP_EXPLAIN[banner]="Asks for your username, lets you pick an ASCII art style, then writes ~/motd.sh — a colored banner with system info that prints on login. It is sourced from .zshrc behind a guard so it never breaks your shell."
STEP_RISK[banner]="low — writes ~/motd.sh and one guarded line in .zshrc."

