)

step_plugins() {
  local enabled=""
  local entry name repo desc enable
  for entry in "${PLUGINS[@]}"; do
    IFS='|' read -r name repo desc enable <<<"$entry"
    section "plugin" "$name"
    wrap "$desc"
    printf '  %sType:%s %s\n' "${C[cyan]}" "${C[reset]}" \
      "$([[ -n "$repo" ]] && echo 'external (git clone)' || echo 'oh-my-zsh built-in')"
    if ((YES)); then
      :
    elif ((NO)); then
      info "skipped"
      continue
    else
      if ! ask_yn "Install $name?" "Y"; then
        info "skipped"
        continue
      fi
    fi

    if [[ -n "$repo" ]]; then
      if [[ "$name" == "powerlevel10k" ]]; then
        git_clone "https://github.com/$repo.git" "$HOME/.oh-my-zsh/custom/themes/$enable" \
          || { err "clone failed for $name"; continue; }
      else
        git_clone "https://github.com/$repo.git" "$HOME/.oh-my-zsh/custom/plugins/$enable" \
          || { err "clone failed for $name"; continue; }
      fi
    fi
    if [[ "$name" != "powerlevel10k" ]]; then
      enabled+="$enable "
    fi
    ok "$name enabled"
  done
  state_set enabled_plugins "${enabled% }"
  ok "plugins done"
}

