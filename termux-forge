# Write colors.properties for a scheme name.
apply_scheme() {
  local name="$1" key vals f="$HOME/.termux/colors.properties"
  key="${name// /_}"
  eval "vals=\${SCHEME_$key:-}"
  [[ -z "$vals" ]] && return 1
  local -a c=($vals)
  local i
  {
    printf '# %s\n' "$name"
    printf 'background=%s\n' "${c[0]}"
    printf 'foreground=%s\n' "${c[1]}"
    printf 'cursor=%s\n'     "${c[2]}"
    for ((i = 0; i < 16; i++)); do
      printf 'color%d=%s\n' "$i" "${c[$((i + 3))]}"
    done
  } > "$f"
  return 0
}

preview_scheme() {
  local f="$HOME/.termux/colors.properties"
  [[ -f "$f" ]] || return 0
  local -a c
  local i hex
  for i in $(seq 0 15); do
    c[$i]="$(grep "^color$i=" "$f" 2>/dev/null | cut -d= -f2)"
  done
  echo
  printf '  %s%s%s\n' "${C[bold]}" "Palette:" "${C[reset]}"
  for i in $(seq 0 7); do
    printf '  '
    hex="${c[$i]}"
    if [[ "$hex" == \#* ]]; then
      printf '\033[48;2;%d;%d;%dm  ' "0x${hex:1:2}" "0x${hex:3:2}" "0x${hex:5:2}"
    fi
  done
  printf '\033[0m\n'
  for i in $(seq 8 15); do
    printf '  '
    hex="${c[$i]}"
    if [[ "$hex" == \#* ]]; then
      printf '\033[48;2;%d;%d;%dm  ' "0x${hex:1:2}" "0x${hex:3:2}" "0x${hex:5:2}"
    fi
  done
  printf '\033[0m\n'
}

step_colors() {
  local schemes=("Argonaut" "Dracula" "Gruvbox Dark" "Nord" "One Half Dark" "Tokyo Night" "Monokai Pro" "Solarized Dark" "Open termux-color TUI" "Keep current colors")
  while :; do
    ask_menu "Choose a color scheme — applied instantly:" 5 "${schemes[@]}"
    local choice="${schemes[$((MENU_CHOICE - 1))]}"
    info "selected: $choice"

    if [[ "$choice" == "Keep current colors" ]]; then
      ok "keeping current colors"
      return 0
    fi

    backup pre-colors "$HOME/.termux/colors.properties"
    if [[ "$choice" == "Open termux-color TUI" ]]; then
      if command -v termux-color >/dev/null; then
        run "termux-color"
        preview_scheme
        if ((YES)); then return 0; fi
        ask_yn "Keep this scheme?" "Y" && return 0
        continue
      else
        err "termux-color not installed — falling back to a preset"
        apply_scheme "One Half Dark" && ok "applied One Half Dark"
      fi
    else
      apply_scheme "$choice" && ok "applied $choice"
    fi
    run "termux-reload-settings"
    preview_scheme
    if ((YES)); then return 0; fi
    ask_yn "Keep this scheme? (no = choose another)" "Y" && return 0
  done
}

# --------------------------------------------------------------------------
# Step: fonts
# --------------------------------------------------------------------------
step_fonts() {
  local props="$HOME/.termux/termux.properties"
  local faces=(
    "MesloLGSNerdFont-Bold.ttf:Bold — heavy, high impact"
    "MesloLGSNerdFont-Regular.ttf:Regular — balanced (default)"
    "MesloLGSNerdFontMono-Bold.ttf:Mono Bold — aligned columns"
    "MesloLGSNerdFontMono-Regular.ttf:Mono Regular — aligned columns"
  )

  section "fonts" "Installed nerd fonts"
  ls "$HOME/.fonts"/*NerdFont*.ttf 2>/dev/null | wc -l | xargs -I{} printf '  %s variants in ~/.fonts\n' {}
  echo

  if (( ! YES )) && ask_yn "Install/fetch a nerd font first?" "Y"; then
    if command -v termux-nf >/dev/null 2>&1; then
      # termux-nf unpacks every face in the family (~34MB). We only ever offer
      # four of them, so prune here rather than leaving a later step to clean up.
      run "termux-nf Meslo"
      tf_prune_fonts
    else
      warn "termux-nf missing — pkg install termux-nf"
    fi
  fi

  backup pre-fonts "$HOME/.termux/font.ttf" "$props"

  # pick which face Termux renders with
  local -a names=()
  local f base
  for f in "$HOME/.fonts"/*NerdFont*.ttf; do
    [[ -f "$f" ]] || continue
    base="$(basename "$f")"
    for face in "${faces[@]}"; do
      [[ "$face" == "$base:"* ]] && names+=("${face%%:*}:${face#*:}")
    done
  done
  if [[ ${#names[@]} -eq 0 ]]; then
    err "no nerd font found in ~/.fonts — install one first"
    return 1
  fi

  local -a opts=()
  for f in "${names[@]}"; do opts+=("${f#*:}"); done

  tf_pick "Which font face?" "font" 1 "${opts[@]}" || { err "cancelled"; return 1; }
  local base
  base="$(printf '%s\n' "${names[@]}" | sed -n "${MENU_CHOICE}p")"
  base="${base%%:*}"

  run "cp $HOME/.fonts/$base $HOME/.termux/font.ttf"
  ok "font face: $base"

  # bold: real bold face above, or synthesised bold on the regular face
  if ask_yn "Force bold rendering?" "N"; then
    if [[ "$base" != *Bold* ]]; then
      if grep -q '^font-bold' "$props" 2>/dev/null; then
        fsed "s|^font-bold=.*|font-bold=true|" "$props"
      else
        run "printf '\nfont-bold=true\n' >> $props"
      fi
      ok "synthesised bold on (font-bold=true)"
    else
      ok "already using a real Bold face"
    fi
  fi

  run "termux-reload-settings"
  ok "fonts applied — restart Termux if glyphs look wrong"
}

# Written blocks, idempotent. step_zshrc regenerates .zshrc from scratch, which
# would otherwise drop every polish block — so it calls this when polish has
# already run. Regenerating the base must not silently un-polish the shell.
tf_write_zsh_blocks() {
  zshrc_append "termux-forge: pager" 'export PAGER="bat --paging=always --style=plain"
export MANPAGER="bat --paging=never --style=plain"
export LESS="-FRX"'

  command -v delta >/dev/null 2>&1 && zshrc_append "termux-forge: delta" \
    'export GIT_PAGER="delta --paging=always"
alias diff="delta"
alias dsd="delta --diff-so-fancy"'

  zshrc_append "termux-forge: fzf" 'export FZF_DEFAULT_OPTS="--height=60% --border=rounded --info=inline --color=border:#88c0d0,prompt:#a3be8c,pointer:#bf616a,info:#4c566a"
export FZF_CTRL_R_OPTS="--preview-window=right:60%:wrap:nowrap --border=rounded --info=inline"'

  if command -v atuin >/dev/null 2>&1 && atuin history list >/dev/null 2>&1; then
    zshrc_append "termux-forge: ctrl-r" 'atuin_bind_ctrl_r() {
  local sel
  sel=$(atuin search --interactive --bind "ctrl-r:accept")
  [[ -n "$sel" ]] && print -z "$sel"
}
zle -N atuin_bind_ctrl_r
bindkey "^R" atuin_bind_ctrl_r'
  else
    zshrc_append "termux-forge: ctrl-r" '_tf_hist_pick() {
  local sel
  sel=$(fc -ln -r -3000 2>/dev/null | tac | grep -v "^[[:space:]]*$" \
        | fzf --height=60% --border=rounded --info=inline --prompt="history> " \
              --color=border:#88c0d0,prompt:#a3be8c,pointer:#bf616a)
  [[ -n "$sel" ]] && print -z -- "$sel"
}
zle -N _tf_hist_pick
bindkey "^R" _tf_hist_pick'
  fi

  local goon
  goon=$(cat <<'GOON'
(( $+functions[add-zsh-hook] )) || autoload -Uz add-zsh-hook
typeset -g _tf_goon=1 _tf_hue=0 _tf_t0=""
typeset -ga _tf_gl=(✦ ✧ ⟡ ◈ ❋ ✺ ⚡ ⋆ ✷ ⟁)

# Load average for the hue. Must not fork on the hot path: a $(...) command
# substitution spawns a subshell on EVERY prompt, which is real latency on a
# phone. So this sets a variable, and the hook reads the variable directly.
_tf_load_refresh() {
  local u
  u="$(uptime 2>/dev/null)"
  _tf_load_cache="${${u##*average: }%%,*}"
  _tf_load_at=$EPOCHSECONDS
}
_tf_load() { (( EPOCHSECONDS - ${_tf_load_at:-0} > 5 )) && _tf_load_refresh; }

_tf_goon_pre() { _tf_t0=$EPOCHREALTIME }

_tf_goon_post() {
  local code=$? dt="" g hue dstr load
  (( _tf_goon )) || return 0
  [[ -n "$_tf_t0" ]] || return 0          # bare Enter: nothing ran
  dt=$(( EPOCHREALTIME - _tf_t0 ))        # no (( )): that truncates floats
  _tf_t0=""
  # hue drifts by load so the prompt mirrors how busy the box is
  _tf_load
  load="${_tf_load_cache:-0}"
  hue=$(( (_tf_hue + 11 + ${load:-0} * 3) % 256 ))
  (( _tf_hue = hue ))
  g=${_tf_gl[RANDOM % ${#_tf_gl}]}
  dstr=$(printf "%.2fs" "$dt")             # %.2f inside print -P would eat %f
  if (( code == 0 )); then
    print -P "%F{38;5;$hue}  $g%f  %F{8}$dstr%f"
  else
    print -P "%F{196}  ✗ ${code}%f  %F{8}$dstr%f"
  fi
}
add-zsh-hook preexec _tf_goon_pre
add-zsh-hook precmd  _tf_goon_post

# tfgo <name> — full-screen animation on demand
tfgo() { command tfloop "$@" 2>/dev/null || command tfloop plasma; }
GOON
)
  zshrc_append "termux-forge: goon" "$goon"
}

