STEP_NAME[speedup]="Speed up the shell"
STEP_DESC[speedup]="Apply performance and hygiene tweaks."
STEP_EXPLAIN[speedup]="Idempotent edits: removes the heavy chpwd eza listing, cleans up .zshenv PATH pollution, enables zsh completion cache, checkpoints the atuin database and disables duplicate history recording. Safe to run repeatedly."
STEP_NAME[theme]="Change prompt theme"
STEP_DESC[theme]="Switch the powerlevel10k theme without rerunning the whole setup."
STEP_EXPLAIN[theme]="Swaps ZSH_THEME between powerlevel10k, agnoster, pure, robbyrussell and avit-xlTips. The variable is injected before powerlevel10k is sourced, because p10k reads its theme once at startup. Restart zsh to see it."
STEP_RISK[theme]="low — appends a tagged block to ~/.zshrc."
STEP_NAME[hostname]="Change hostname"
STEP_DESC[hostname]="Set the hostname shown in the banner and prompt."
STEP_EXPLAIN[hostname]="Rewrites the hostname that ~/motd.sh and the prompt display, without touching your real system hostname. Stored as an override near the top of motd.sh so it is instant and reversible. Your actual machine hostname is never modified."
STEP_RISK[hostname]="low — appends a tagged block to ~/motd.sh."
STEP_NAME[prompt]="Prompt modification"
STEP_DESC[prompt]="Restyle the powerlevel10k prompt: pick a premade prompt personality, turn on bold glyphs, force single-line or two-line, and preview each one live."
