      ;;
    bloodmoon)
      # no box: a red wash of blocks, ragged on purpose
      echo '    TF_TEXT_LINES+=("${R}░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░${N}")'
      echo '    TF_TEXT_LINES+=("${R}░░${N}  ${W}${TF_USER}@${TF_HOST}${N}")'
      echo '    TF_TEXT_LINES+=("${R}░░${N}  ${D}up${N}  ${TF_UPTIME}")'
      echo '    TF_TEXT_LINES+=("${R}░░${N}  ${D}mem${N} ${TF_RAM}   ${D}disk${N} ${TF_DISK}")'
      echo '    TF_TEXT_LINES+=("${R}░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░${N}")'
      ;;
    hypno)
      # hue wheels shift every shell open — same style, never the same twice
      echo '    TF_TEXT_LINES+=("${W}${TF_USER}@${TF_HOST}${N}")'
      echo '    TF_TEXT_LINES+=("$(h $H1)$(h $H2)▚▚▚$(h $H1)▚▚▚$(h $H2)▚▚▚$(h $H1)▚▚▚$(h $H2)▚▚▚$(h $H1)▚▚▚$(h $H2)▚▚▚$(h $H1)▚▚▚$(h $H2)▚▚▚${N}")'
      echo '    TF_TEXT_LINES+=("$(h $H3)${TF_UPTIME} $(h $H1)· $(h $H3)${TF_RAM} $(h $H1)· $(h $H3)${TF_DISK}${N}")'
      echo '    TF_TEXT_LINES+=("$(h $H1)${TF_MODEL} $(h $H2)· $(h $H1)Android ${TF_SYSTEM}${N}")'
      echo '    TF_TEXT_LINES+=("$(h $H2)▚▚▚$(h $H1)▚▚▚$(h $H2)▚▚▚$(h $H1)▚▚▚$(h $H2)▚▚▚$(h $H1)▚▚▚$(h $H2)▚▚▚$(h $H1)▚▚▚$(h $H2)▚▚▚${N}")'
      ;;
    neon)
      # every row puts ALL visible text in _a, then pads to 34 — no hand-counting
      echo '    TF_TEXT_LINES+=("${C_CY}╭${C_PNK}◤${C_CY}$(pad 32)${C_PNK}◢╮${N}")'
      echo '    _a=" ✦ ${TF_USER}@${TF_HOST} ✦"; TF_TEXT_LINES+=("${C_CY}│${N}${W}${_a}${N}$(pad $(( 34 - ${#_a} )))${C_CY}│${N}")'
      echo '    _a=" ${TF_UPTIME}"; TF_TEXT_LINES+=("${C_PNK}│${N}${D}${_a}${N}$(pad $(( 34 - ${#_a} )))${C_PNK}│${N}")'
      echo '    _a=" ${TF_RAM}  disk ${TF_DISK}"; TF_TEXT_LINES+=("${C_PNK}│${N}${_a}${N}$(pad $(( 34 - ${#_a} )))${C_PNK}│${N}")'
      echo '    _a=" ${TF_MODEL}  pkgs ${TF_PKGS}"; TF_TEXT_LINES+=("${C_PNK}│${N}${_a}${N}$(pad $(( 34 - ${#_a} )))${C_PNK}│${N}")'
      echo '    TF_TEXT_LINES+=("${C_CY}╰$(pad 34)╯${N}")'
      ;;
    crt)
      echo '    TF_TEXT_LINES+=("${G}┌$(pad 34)┐${N}")'
      echo '    _a=" ▓ ${TF_USER}@${TF_HOST} [ONLINE]"; TF_TEXT_LINES+=("${G}│${N}${W}${_a}${N}$(pad $(( 34 - ${#_a} )))${G}│${N}")'
      echo '    TF_TEXT_LINES+=("${G}├$(pad 34)┤${N}")'
      echo '    _a=" UPTIME ${TF_UPTIME}"; TF_TEXT_LINES+=("${G}│${N}${D}${_a}${N}$(pad $(( 34 - ${#_a} )))${G}│${N}")'
      echo '    _a=" MEM    ${TF_RAM}"; TF_TEXT_LINES+=("${G}│${N}${D}${_a}${N}$(pad $(( 34 - ${#_a} )))${G}│${N}")'
      echo '    _a=" DISK   ${TF_DISK}"; TF_TEXT_LINES+=("${G}│${N}${D}${_a}${N}$(pad $(( 34 - ${#_a} )))${G}│${N}")'
      echo '    _a=" PKGS   ${TF_PKGS}"; TF_TEXT_LINES+=("${G}│${N}${D}${_a}${N}$(pad $(( 34 - ${#_a} )))${G}│${N}")'
      echo '    TF_TEXT_LINES+=("${G}└$(pad 34)┘${N}")'
      ;;
    vaporwave)
      # no right edge on purpose: values vary in width, so a grid can't close
      echo '    TF_TEXT_LINES+=("${M}▚▚▚${C_PNK}▚▚▚${C_CY}▚▚▚${M}▚▚▚${C_PNK}▚▚▚${C_CY}▚▚▚${M}▚▚▚${C_PNK}▚▚▚${N}")'
      echo '    TF_TEXT_LINES+=("${M}║${N}  ${C_CY}△${N} ${W}${TF_USER}${M}@${TF_HOST}  ${C_PNK}✦${N}")'
      echo '    TF_TEXT_LINES+=("${M}║${N}  ${D}up${N}   ${M}${TF_UPTIME}")'
      echo '    TF_TEXT_LINES+=("${M}║${N}  ${D}mem${N}  ${M}${TF_RAM}    ${D}disk${N} ${M}${TF_DISK}")'
      echo '    TF_TEXT_LINES+=("${M}║${N}  ${D}dev${N}  ${M}${TF_MODEL}")'
      echo '    TF_TEXT_LINES+=("${M}║${N}  ${C_CY}◈${N} ${D}pkgs${N} ${M}${TF_PKGS}")'
      echo '    TF_TEXT_LINES+=("${C_CY}╚${M}▚▚▚${C_PNK}▚▚▚${C_CY}▚▚▚${M}▚▚▚${C_PNK}▚▚▚${C_CY}▚▚▚${M}▚▚▚${C_PNK}▚▚▚${N}")'
      ;;
    plain|*)
      echo '    TF_TEXT_LINES+=("${D}user${N}    ${C}${TF_USER}${N}")'
      echo '    TF_TEXT_LINES+=("${D}host${N}    ${W}${TF_HOST}${N}")'
      echo '    TF_TEXT_LINES+=("${D}uptime${N}  ${TF_UPTIME}")'
      echo '    TF_TEXT_LINES+=("${D}pkgs${N}    ${TF_PKGS}")'
      echo '    TF_TEXT_LINES+=("${D}mem${N}     ${TF_MEM}")'
      echo '    TF_TEXT_LINES+=("${D}disk${N}    ${TF_DISK}")'
      echo '    TF_TEXT_LINES+=("${D}ip${N}      ${TF_IP}")'
      echo '    TF_TEXT_LINES+=("${D}date${N}    ${TF_DATE}")'
      ;;
  esac
}

tf_generate_motd() {
  local style="$1" position="$2" username="${3:-}" takeover="${4:-none}"
  local content body
  content=$(cat <<'MOTD'
#!/data/data/com.termux/files/usr/bin/bash
# Generated by termux-forge — login banner
R=$'\033[1;31m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; C=$'\033[1;36m'; W=$'\033[1;37m'; D=$'\033[2m'; N=$'\033[0m'
C_ART=$'\033[38;5;103m'; C_LBL=$'\033[38;5;60m'; C_TXT=$'\033[38;5;250m'; C_GRY=$'\033[38;5;240m'; C_CMD=$'\033[38;5;245m'
C_CY=$'\033[38;5;51m'; C_PNK=$'\033[38;5;212m'; M=$'\033[38;5;213m'
# hue wheels — new colours every shell open, for the trippy styles
H0=$((RANDOM % 256)); H1=$(((H0 + 40) % 256)); H2=$(((H0 + 160) % 256)); H3=$(((H0 + 210) % 256))
h() { printf '\033[38;5;%dm' "$1"; }
# box padding — probes vary in width, so boxes pad at runtime instead of
# hardcoding spaces that go ragged the moment uptime changes
pad() { local n="$1"; ((n < 0)) && n=0; printf '%*s' "$n" ''; }
TF_STYLE="__STYLE__"
TF_POSITION="__POSITION__"
TF_TAKEOVER="__TAKEOVER__"
TF_USER="__USERNAME__"
TF_HOST="$(hostname 2>/dev/null || echo termux)"
TF_MODEL="$(getprop ro.product.model 2>/dev/null || echo Android)"
TF_SYSTEM="$(getprop ro.build.version.release 2>/dev/null || echo '?')"
TF_KERNEL="$(uname -r | cut -d'-' -f1)"
TF_UPTIME="$(awk '{printf "%dh %dm\n", $1/3600, ($1%3600)/60}' /proc/uptime 2>/dev/null || uptime -p 2>/dev/null || uptime | sed 's/.*up //;s/,.*//')"
TF_BATTERY="$(cat /sys/class/power_supply/battery/capacity 2>/dev/null || echo N/A)%"
TF_SHELLV="${ZSH_VERSION:-$BASH_VERSION}"
TF_PKGS="$(ls "$PREFIX"/var/lib/dpkg/info/*.list 2>/dev/null | wc -l)"
TF_RAM="$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "%.1fG / %.1fG", (t-a)/1024/1024, t/1024/1024}' /proc/meminfo 2>/dev/null || free -m 2>/dev/null | awk '/Mem:/{printf "%d/%d MB", $3, $2}' || echo n/a)"
TF_DISK="$(df -h /data 2>/dev/null | awk 'NR==2{print $3 "/" $2}' || echo n/a)"
TF_IP="$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}' || hostname -I 2>/dev/null | awk '{print $1}' || echo n/a)"
TF_DATE="$(date '+%Y-%m-%d %H:%M')"

tf_quotes=(
  "Talk is cheap. Show me the code."
  "Code never lies, comments sometimes do."
  "Simplicity is the soul of efficiency."
  "Stay hungry, stay foolish."
  "It works on my machine."
  "Deleted code is debugged code."
  "Make it work, make it right, make it fast."
  "The best error message is the one that never shows up."
)

tf_tips=(
  "Use 'Ctrl+R' to search history backward."
  "Type 'cd <folder>' — Zoxide enabled for fast jumps."
  "Alt+. inserts the last argument of the previous command."
  "Type 'ftext <string>' to fast-search file contents."
  "Type 'findbig' to locate files > 100MB."
  "Type 'tfart' to switch your ASCII art."
  "Type 'setbg' to change your terminal background."
  "Type 'reveal' to show your network info."
  "Type '!!' to run the last command again."
  "Type 'cd -' to toggle previous directory."
)

tf_text() {
  TF_TEXT_LINES=()
  case "$TF_STYLE" in
__STYLE_BODY__
  esac
}

tf_render() {
  local i
  TF_ART=()
  if [[ -f "$HOME/.termux/ascii_art.txt" ]]; then
    while IFS= read -r line; do
      TF_ART+=("$line")
    done < "$HOME/.termux/ascii_art.txt"
  fi
  if [[ "$TF_POSITION" == "right" && ${#TF_ART[@]} -gt 0 ]]; then
    local aw=0
    for i in "${TF_ART[@]}"; do
      (( ${#i} > aw )) && aw=${#i}
    done
    local toff=0
    (( ${#TF_ART[@]} > ${#TF_TEXT_LINES[@]} )) && toff=$(( (${#TF_ART[@]} - ${#TF_TEXT_LINES[@]}) / 2 ))
    for ((i=0; i<${#TF_ART[@]}; i++)); do
      local a="${TF_ART[$i]:-}"
      local t=""
      local ti=$(( i - toff ))
      if (( ti >= 0 && ti < ${#TF_TEXT_LINES[@]} )); then
        t="${TF_TEXT_LINES[$ti]}"
      fi
      printf '  %s   %s\n' "$(printf '%-*s' "$aw" "$a")" "$t"
    done
  else
    for i in "${TF_ART[@]}"; do printf '  %s\n' "$i"; done
    echo
    for i in "${TF_TEXT_LINES[@]}"; do printf '  %s\n' "$i"; done
  fi
  echo
}

# full-screen takeover first, so the banner lands after the animation
if [ "$TF_TAKEOVER" != "none" ] && command -v tfloop >/dev/null 2>&1; then
  timeout 7 tfloop "$TF_TAKEOVER" 16 || true
fi

tf_text
tf_render

rand_q=$(( RANDOM % ${#tf_quotes[@]} ))
rand_t=$(( RANDOM % ${#tf_tips[@]} ))
printf "\n  ${C_GRY}>> ${C_TXT}\033[1m${tf_quotes[$rand_q]}${C_RST}"
printf "\n  ${C_GRY}>> ${C_CMD}TIP: ${C_TXT}${tf_tips[$rand_t]}${C_RST}\n"
MOTD
)
  body="$(tf_style_lines "$style")"
  local replacement="${style})"$'\n'"${body}"$'\n'"    ;;"
  content="${content//__STYLE_BODY__/$replacement}"
  content="${content//__STYLE__/$style}"
  content="${content//__POSITION__/$position}"
  content="${content//__USERNAME__/$username}"
  content="${content//__TAKEOVER__/$takeover}"
  printf '%s\n' "$content" > "$HOME/motd.sh"
  chmod +x "$HOME/motd.sh"
}

ascii_art() {
  case "$1" in
    0) cat <<'ART'
  _____                   _  __
 |_   _|__ _ __ _   _  _| |/ /
   | |/ _ \ '__| | | | | | ' /
   | |  __/ |  | |_| | | | . \
   |_|\___|_|   \__,_| |_|_|\_\
ART
      ;;
    1) cat <<'ART'
      /\
     /  \
    / /\ \
   / /  \ \
  /_/    \_\
ART
      ;;
    2) cat <<'ART'
   /\_/\
  ( o.o )
   > ^ <
ART
      ;;
    3) cat <<'ART'
   ____  ____  ____
 |  _ \/ ___||___ \
 | |_) \___ \ __) |
 |  __/ ___) | __/
 |_|   |____/|_____|
ART
      ;;
    4) printf '%s\n' "no art" ;;
  esac
}

tf_art_write() {
  local name="$1"
  mkdir -p "$HOME/.termux"
  case "$name" in
    "None"|"No art"|"none"|"")
      run "rm -f $HOME/.termux/ascii_art.txt"
      ;;
    "Termux T logo")
      ascii_art 0 > "$HOME/.termux/ascii_art.txt"
      ;;
    "Rocket")
      ascii_art 1 > "$HOME/.termux/ascii_art.txt"
      ;;
    "Cat")
      ascii_art 2 > "$HOME/.termux/ascii_art.txt"
      ;;
    "Skull")
      ascii_art 3 > "$HOME/.termux/ascii_art.txt"
      ;;
    *)
      local f="$HOME/.termux/ascii/${name}.txt"
      if [[ -f "$f" ]]; then
        run "cp $f $HOME/.termux/ascii_art.txt"
      else
        run "rm -f $HOME/.termux/ascii_art.txt"
      fi
      ;;
  esac
}

tf_art_options() {
  local -a opts=("Termux T logo" "Rocket" "Cat" "Skull")
  local f
  if [[ -d "$HOME/.termux/ascii" ]]; then
    for f in "$HOME/.termux/ascii"/*.txt; do
      [[ -f "$f" ]] || continue
      opts+=("$(basename "$f" .txt)")
    done
  fi
  opts+=("None")
  printf '%s\n' "${opts[@]}"
}

tf_style_options() {
  printf '%s\n' boxed minimal arrow tabbed dashed double centered icons compact banner json plain labeled cyber candy retro matrix minimalv orbit bloodmoon hypno neon crt vaporwave
}

step_banner() {
  local username art_choice style_choice position takeover
  takeover="$(state_get banner_takeover)"; takeover="${takeover:-none}"
  username="$(state_get username)"
  [[ -z "$username" ]] && username="$(whoami)"
  username="$(ask_input "Your username (shown in the banner)" "$username")"
  state_set username "$username"

  local -a arts styles
  mapfile -t arts < <(tf_art_options)
  mapfile -t styles < <(tf_style_options)

  while :; do
    if ! tf_pick "Select banner art:" "art" 1 "${arts[@]}"; then
      err "cancelled"; return 1
    fi
    art_choice="${arts[$((MENU_CHOICE - 1))]}"
    info "art: $art_choice"

    if ! tf_pick "Select info-text style:" "style" 1 "${styles[@]}"; then
      err "cancelled"; return 1
    fi
    style_choice="${styles[$((MENU_CHOICE - 1))]}"
    info "style: $style_choice"

    tf_pick "Where should the info text appear?" "none" 1 \
      "Below the art" "Right side of the art" || { err "cancelled"; return 1; }
    position="$([[ "$MENU_CHOICE" == "1" ]] && echo below || echo right)"
    info "position: $position"

    # full-screen animation takeover — this is the actually-gooning part
    tf_pick "Animation on terminal open? (preview plays in the pane)" "anim" 1 \
      "None — banner only" "tunnel" "warp" "plasma" "ripple" "moire" \
      || { err "cancelled"; return 1; }
    case "$MENU_CHOICE" in
      1) takeover=none ;;
      2) takeover=tunnel ;; 3) takeover=warp ;; 4) takeover=plasma ;;
      5) takeover=ripple ;; 6) takeover=moire ;;
      *) takeover=none ;;
    esac
    info "takeover: $takeover"
    state_set banner_takeover "$takeover"
    [[ "$takeover" != none ]] && info "plays for a few seconds on every shell start — any key skips"

    backup pre-banner "$HOME/motd.sh" "$HOME/.termux/ascii_art.txt"
    tf_art_write "$art_choice"
    tf_generate_motd "$style_choice" "$position" "$username" "$takeover"

    tf_full_preview "PREVIEW — how it will look" bash "$HOME/motd.sh"

    if ((YES)); then break; fi
    if ask_yn "Keep this banner? (no = try another)" "Y"; then break; fi
    echo
    info "starting over — pick a new combination"
  done
  ok "banner written to ~/motd.sh"

  if ! grep -q 'motd.sh' "$HOME/.zshrc" 2>/dev/null; then
    run "printf '\n# termux-forge banner\n[[ -f ~/motd.sh ]] && source ~/motd.sh\n' >> $HOME/.zshrc"
    ok "banner wired into .zshrc"
  fi
}

# --------------------------------------------------------------------------
# Step: theme  (powerlevel10k theme)
# --------------------------------------------------------------------------
step_theme() {
  local themes="powerlevel10k agnoster pure robbyrussell avit-xlTips"
  local tdir="$HOME/.oh-my-zsh/custom/themes"
  local choice
  backup pre-theme "$HOME/.zshrc"

  if [[ ! -d "$tdir/powerlevel10k" ]]; then
    err "powerlevel10k not installed — run the p10k step first"
    return 1
  fi

  tf_pick "Prompt theme?" "theme" 1 $themes || { err "cancelled"; return 1; }
  choice="$(printf '%s\n' $themes | sed -n "${MENU_CHOICE}p")"
  info "theme: $choice"
  state_set theme_name "$choice"

  zshrc_block before 'source ~/\.p10k\.zsh' "termux-forge: theme" \
    "typeset -g ZSH_THEME=\"$choice\"
typeset -g POWERLEVEL9K_MODE=production"
  ok "theme set to $choice"
  warn "restart zsh (exec zsh) to see it"
}

# --------------------------------------------------------------------------
# Step: hostname
# --------------------------------------------------------------------------
step_hostname() {
  local name
  backup pre-hostname "$HOME/motd.sh"

  name="$(ask_input "Hostname shown in the banner and prompt" "$(hostname 2>/dev/null || echo termux)")"
  [[ -z "$name" ]] && { err "empty hostname"; return 1; }
  state_set hostname "$name"
  ok "hostname: $name"

  if [[ -f "$HOME/motd.sh" ]]; then
    if grep -q '^TF_HOST=' "$HOME/motd.sh"; then
      fsed "s|^TF_HOST=.*|TF_HOST=\"\$(hostname 2>/dev/null || echo $name)\"|" "$HOME/motd.sh"
    fi
    # banner reads the override first, so the change is instant and reversible
    fsed '/^TF_HOST=/d' "$HOME/motd.sh"
    if ! grep -q '_TF_HOST_OVERRIDE' "$HOME/motd.sh"; then
      run "printf '\n# termux-forge hostname\n_TF_HOST_OVERRIDE=\"$name\"\n' >> $HOME/motd.sh"
    fi
    fsed 's|^TF_HOST="\$(hostname.*|TF_HOST="${_TF_HOST_OVERRIDE:-$(hostname 2>/dev/null \|\| echo termux)}"|' "$HOME/motd.sh"
    ok "motd.sh now shows $name"
  fi

  if grep -q 'termux-forge: prompt' "$HOME/.zshrc" 2>/dev/null; then
    warn "your prompt personality uses %m (real hostname) — restart zsh or edit that block to show '$name'"
  fi
}

# --------------------------------------------------------------------------
# Step: prompt
# --------------------------------------------------------------------------
step_prompt() {
  local personalities="nerdy leet hacker rainbow minimal corporate chaotic boxy"
  local choice bold layout
  backup pre-prompt "$HOME/.p10k.zsh" "$HOME/.zshrc"

  tf_pick "Prompt personality? (preview on the right)" "prompt" 1 $personalities \
    || { err "cancelled"; return 1; }
  choice="$(printf '%s\n' $personalities | sed -n "${MENU_CHOICE}p")"
  info "personality: $choice"
  state_set prompt_personality "$choice"

  # no forced BOLD / heavy glyph padding: on Android that tanks redraw speed.
  # p10k snapshots its config when sourced, so this MUST land before that line.
  if ask_yn "Two-line prompt?" "N"; then layout=two; else layout=single; fi

  zshrc_block before 'source ~/\.p10k\.zsh' "termux-forge: prompt" "$block"
  ok "prompt set to $choice ($layout-line)"
  if [[ -t 0 ]]; then
    warn "restart zsh (exec zsh) or open a new terminal to see the new prompt"
  fi
}

# --------------------------------------------------------------------------
# Step: zshrc
# --------------------------------------------------------------------------
step_zshrc() {
  local enabled; enabled="$(state_get enabled_plugins)"
  local plugin_list="git"
  local p fsh="" dropped=""
  local omz="$HOME/.oh-my-zsh" custom="$HOME/.oh-my-zsh/custom/plugins"
  # a plugin only counts if it is actually on disk — otherwise oh-my-zsh prints
  # "plugin not found" on every single shell start
  _tf_has_plugin() {
    [[ "$1" == git ]] && return 0
    [[ -d "$custom/$1" || -d "$omz/plugins/$1" ]]
  }
  for p in $enabled; do
    # powerlevel10k is a THEME (ZSH_THEME), not a plugin.
    # zsh-autocomplete conflicts with zsh-syntax-highlighting + zsh-history-substring-search
    # and emits "unhandled ZLE widget" spam (menu-search / recent-paths).
    # fast-syntax-highlighting is a dead fork of zsh-syntax-highlighting (archived upstream).
    [[ "$p" == "git" || "$p" == "powerlevel10k" || "$p" == "zsh-autocomplete" || "$p" == "fast-syntax-highlighting" ]] && continue
    _tf_has_plugin "$p" || { dropped+="$p "; continue; }
    if [[ "$p" == "zsh-syntax-highlighting" ]]; then fsh="zsh-syntax-highlighting"; continue; fi
    plugin_list+=" $p"
  done
  [[ -n "$fsh" ]] && plugin_list+=" $fsh"

  backup pre-zshrc "$HOME/.zshrc"
  emit "$HOME/.zshrc" <<ZSHRC
# ~/.zshrc — generated by termux-forge v${VERSION}
# Enable p10k instant prompt (must stay at the top)
if [[ -r "\${XDG_CACHE_HOME:-\$HOME/.cache}/p10k-instant-prompt-\${(%):-%n}.zsh" ]]; then
  source "\${XDG_CACHE_HOME:-\$HOME/.cache}/p10k-instant-prompt-\${(%):-%n}.zsh"
fi

export ZSH="\$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=($plugin_list)
source \$ZSH/oh-my-zsh.sh

# re-run compinit after all plugins load — fixes zsh-autocomplete completion errors
autoload -Uz compinit && compinit

# completion cache (speed)
zstyle ':completion:*' cache-path "\$HOME/.zcache"
mkdir -p "\$HOME/.zcache"

# history — atuin only (single source of truth)
# atuin 18.23 is broken on Android (keyctl denied), so probe before wiring it
if command -v atuin >/dev/null && atuin history list >/dev/null 2>&1; then
  export ATUIN_NOBIND="true"
  eval "\$(atuin init zsh)"
else
  export HISTFILE="\$HOME/.zsh_history"
  export HISTSIZE=50000
  export SAVEHIST=50000
fi

# zoxide — smart cd
eval "\$(zoxide init zsh)"

# p10k config
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# PATH hygiene
export PATH="\$HOME/.local/bin:\$PATH"

# --- aliases ---
alias ls="eza --icons"
alias la="eza --icons -lgha --group-directories-first"
alias l="eza --icons -lgha --group-directories-first"
alias lt="eza --icons --tree"
alias cat="bat --color=always --style=plain"
alias ..="cd .."
alias ...="cd ../.."
alias q="exit"
alias c="clear"
alias py="python3"
alias g="git"
alias up="pkg update -y && pkg upgrade -y"
alias myip="curl -fsS ifconfig.me"
alias setlook="termux-nf Meslo"
alias setstyle="termux-color"
alias setprompt="p10k configure"

# --- functions ---
mkcd() { mkdir -p "\$1" && cd "\$1"; }
fkill() { ps aux | fzf --multi --height 40% | awk '{print \$2}' | xargs -r kill; }
extract() { [[ -f "\$1" ]] || { echo "not a file: \$1"; return 1; }
  case "\$1" in
    *.tar.gz|*.tgz) tar xzf "\$1" ;;
    *.tar.xz) tar xJf "\$1" ;;
    *.zip) unzip "\$1" ;;
    *.rar) unrar x "\$1" ;;
    *.7z) 7z x "\$1" ;;
    *) echo "unknown archive: \$1" ;;
  esac
}

# light chpwd — no heavy listing on every cd
# no pager + one line + quiet: a cd into / used to spew permission errors
chpwd() { eza --icons --no-user -1 --color=always 2>/dev/null; }

# termux-forge banner — deferred to first prompt to avoid p10k instant-prompt warning
if [[ -f ~/motd.sh ]]; then
  _tf_motd_done=0
  _tf_motd() {
    (( _tf_motd_done )) && return
    _tf_motd_done=1
    bash ~/motd.sh
  }
  precmd_functions+=(_tf_motd)
fi
ZSHRC
  ok ".zshrc written"
  [[ -n "$dropped" ]] && warn "not installed, skipped:$dropped"

  # a fresh .zshrc drops every tagged block. Re-apply them if polish/theme/prompt
  # have already run, otherwise regenerating the base would silently un-polish
  # the shell.
  local reap="" sid
  for sid in theme prompt polish; do
    [[ "$(state_get "$sid")" == done ]] && reap+="$sid "
  done
  if [[ -n "$reap" ]]; then
    tf_write_zsh_blocks
    # theme/prompt blocks live *before* the p10k source, so replay them too
    [[ "$reap" == *theme* ]] && zshrc_block before 'source ~/\.p10k\.zsh' "termux-forge: theme" \
      "typeset -g ZSH_THEME=\"$(state_get theme_name)\"
typeset -g POWERLEVEL9K_MODE=production"
    ok "re-applied blocks for:$reap"
  fi
}

# --------------------------------------------------------------------------
# Step: speedup
# --------------------------------------------------------------------------
step_speedup() {
  backup pre-speedup "$HOME/.zshrc" "$HOME/.zshenv"

  # 1. remove heavy chpwd eza listing
  if grep -q 'chpwd() { eza --icons -lgha' "$HOME/.zshrc" 2>/dev/null; then
    fsed 's/^chpwd() { eza --icons -lgha.*/# no pager + one line + quiet: a cd into / used to spew permission errors
chpwd() { eza --icons --no-user -1 --color=always 2>/dev/null; }/' "$HOME/.zshrc"
    ok "lightened chpwd hook"
  fi

  # 2. clean .zshenv PATH pollution
  if [[ -f "$HOME/.zshenv" ]]; then
    fsed '/^export PATH="\$HOME\/bin/d; /^export PATH="\$HOME\/.local\/bin/d; /^export PATH="\$HOME\/.npm-global\/bin/d' "$HOME/.zshenv"
    ok "cleaned .zshenv PATH"
  fi

  # 3. completion cache
  if ! grep -q "cache-path" "$HOME/.zshrc" 2>/dev/null; then
    run "printf '\nzstyle '\'':completion:*'\'' cache-path \"\$HOME/.zcache\"\n' >> \$HOME/.zshrc"
    ok "enabled completion cache"
  fi

  # 4. atuin WAL checkpoint
  if command -v atuin >/dev/null; then
    run "atuin --version >/dev/null 2>&1 && sqlite3 '$HOME/.local/share/atuin/history.db' 'PRAGMA wal_checkpoint(TRUNCATE);' 2>/dev/null || true"
    ok "atuin checkpoint attempted"
  fi

  # 5. disable duplicate history recording when atuin is active
  if grep -q 'eval "$(atuin init zsh)"' "$HOME/.zshrc" 2>/dev/null; then
    fsed 's/^setopt share_history/# setopt share_history/; s/^setopt inc_append_history/# setopt inc_append_history/' "$HOME/.zshrc"
    ok "disabled duplicate history recording"
  fi
}

# --------------------------------------------------------------------------
# Step: cleanup
# --------------------------------------------------------------------------
step_cleanup() {
  local orphans=(
    "$HOME/.oh-my-zsh"
    "$HOME/.zsh-plugins"
    "$HOME/powerlevel10k"
    "$HOME/dotfiles"
    "$HOME/Flame-OS"
    "$HOME/tstyle"
    "$HOME/.termux.backup"
    "$HOME/.shell.pre-oh-my-zsh"
  )
  local o size
  for o in "${orphans[@]}"; do
    [[ -e "$o" ]] || continue
    size="$(du -sh "$o" 2>/dev/null | cut -f1)"
    section "cleanup" "$o"
    printf '  %ssize:%s %s\n' "${C[cyan]}" "${C[reset]}" "$size"
    if ((YES)); then
      :
    elif ((NO)); then
      info "kept"
      continue
    else
      if ! ask_yn "Delete $o?" "N"; then
        info "kept"
        continue
      fi
    fi
    run "rm -rf '$o'"
    ok "removed $o"
  done

  # our own stale scratch files, if any got left behind
  local scratch=("$SCRIPT_DIR/tf-test" "$SCRIPT_DIR/tf-schemes.json" "$SCRIPT_DIR/tf-apply-scheme.txt")
  local sp
  for sp in "${scratch[@]}"; do
    [[ -e "$sp" ]] && { run "rm -rf '$sp'"; ok "removed $(basename "$sp")"; }
  done
}

# --------------------------------------------------------------------------
# Step: repair
# --------------------------------------------------------------------------
step_repair() {
  # 1. restore the dpkg-owned /usr/etc/motd file
  if ! dpkg -V termux-tools >/dev/null 2>&1; then
    info "termux-tools integrity OK"
  else
    warn "termux-tools has missing files — reinstalling"
    run "pkg reinstall -y termux-tools"
  fi

  # 2. remove the orphaned motd/init.sh line from zprofile
  local zp="$PREFIX/etc/zprofile"
  if [[ -f "$zp" ]] && grep -q 'motd/init.sh' "$zp"; then
    backup pre-repair "$zp"
    fsed '\#motd/init.sh#d' "$zp"
    ok "removed orphan motd line from zprofile"
  else
    ok "zprofile clean"
  fi

  # 3. defuse ninja.sh root-repo install
  if [[ ! -f "$HOME/.ninja_prepped" ]]; then
    run "touch '$HOME/.ninja_prepped'"
    ok "ninja.sh defused (root-repo will not auto-install)"
  else
    ok "ninja.sh already defused"
  fi

  # 4. fix the fake IP in the banner
  if [[ -f "$HOME/.termux_banner.sh" ]] && grep -q '192.168.31.116' "$HOME/.termux_banner.sh"; then
    fsed 's/192\.168\.31\.116/<dynamic>/' "$HOME/.termux_banner.sh"
    ok "fixed hardcoded IP in .termux_banner.sh"
  fi
}

# --------------------------------------------------------------------------
# Step: finish
# --------------------------------------------------------------------------
zshrc_append() {
  # Append a tagged block to the END of .zshrc. Existing blocks with the same
  # tag are stripped first so re-running refreshes them. Appending last matters:
  # p10k and atuin both rebind keys, so our bindings must come after them.
  zshrc_block insert "" "$1" "$2"
}

# zshrc_block <before|append> <anchor-regex> <tag> <body>
# Tagged block, old copy stripped first so re-running replaces instead of
# stacking. `before` is required for anything p10k reads: p10k snapshots its
# POWERLEVEL9K_* config when it is sourced, so a block placed after that line
# is silently discarded.
zshrc_block() {
  local where="$1" anchor="$2" tag="$3" body="$4" tmp clean
  if ((DRY_RUN)); then
    printf '  %s$%s zshrc_block %s %s\n' "${C[dim]}" "${C[reset]}" "$where" "$tag"
    return 0
  fi
  tmp="$HOME/.zshrc.tmp.$$"; clean="$HOME/.zshrc.clean.$$"
  : > "$clean"
  [[ -f "$HOME/.zshrc" ]] && cp "$HOME/.zshrc" "$clean"

  # 1. strip any previous copy of this tag
  if [[ -s "$clean" ]]; then
    awk -v t="# $tag" '
      $0 == t { skip = 1; next }
      skip && /^# termux-forge:/ { skip = 0; next }
      skip { next }
      { print }
    ' "$clean" > "$tmp"
  else
    : > "$tmp"
  fi

  # 2. place it
  if [[ "$where" == before && -n "$anchor" ]] && grep -qE "$anchor" "$tmp"; then
    awk -v a="$anchor" -v t="# $tag" -v b="$body" '
      !done && $0 ~ a { printf "\n%s\n%s\n", t, b; done = 1 }
      { print }
      END { if (!done) exit 3 }        # anchor vanished mid-pass
    ' "$tmp" > "$HOME/.zshrc" && rm -f "$tmp" && return 0
    # fell through: anchor disappeared, fall back to append
  fi

  { cat "$tmp"; printf '\n%s\n%s\n' "# $tag" "$body"; } > "$HOME/.zshrc"
  rm -f "$tmp" "$clean"
}

step_polish() {
  backup pre-polish "$HOME/.zshrc" "$HOME/.gitconfig"

  # --- 1. pager glue: bat everywhere ---
  if ask_yn "Use bat as your pager (coloured git/apt/less output)?" "Y"; then
    zshrc_append "termux-forge: pager" 'export PAGER="bat --paging=always --style=plain"
export MANPAGER="bat --paging=never --style=plain"
export LESS="-FRX"'
    ok "pager: bat"
  fi

  # --- 2. git identity ---
  local gname="" gmail=""
  if [[ -n "$(git config --global user.name 2>/dev/null)" ]]; then
    info "git identity already set: $(git config --global user.name)"
  elif ask_yn "Set your git user.name and user.email?" "Y"; then
    gname="$(ask_input "git user.name" "$(whoami)")"
    gmail="$(ask_input "git user.email" "you@example.com")"
    [[ -n "$gname" ]] && run "git config --global user.name '$gname'"
    [[ -n "$gmail" ]] && run "git config --global user.email '$gmail'"
    ok "git identity set"
  fi

  # --- 3. delta for readable diffs ---
  if ! command -v delta >/dev/null 2>&1; then
    if ask_yn "Install delta (colourful side-by-side git diffs)?" "Y"; then
      pkg_install git-delta
    fi
  fi
  if command -v delta >/dev/null 2>&1; then
    # clear the bad line older versions of this script wrote
    fsed '/^eval "\$(delta --configure-git-features)"$/d' "$HOME/.zshrc" 2>/dev/null
    # delta 0.19 has no --configure-git-features; wire it through git config
    run "git config --global core.pager 'delta --paging=always'"
    run "git config --global interactive.diffFilter 'delta --color-only'"
    run "git config --global branch.sort -c"
    zshrc_append "termux-forge: delta" 'export GIT_PAGER="delta --paging=always"
alias diff="delta"
alias dsd="delta --diff-so-fancy"'
    ok "delta wired up"
  fi

  # --- 4. fzf defaults ---
  if ask_yn "Set fzf defaults (border + taller list + colour preview)?" "Y"; then
    local fz_block
    fz_block=$(printf '%s\n' \
      'export FZF_DEFAULT_OPTS="--height=60% --border=rounded --info=inline --color=border:#88c0d0,prompt:#a3be8c,pointer:#bf616a,info:#4c566a"' \
      'export FZF_CTRL_R_OPTS="--preview-window=right:60%:wrap:nowrap --border=rounded --info=inline"')
    zshrc_append "termux-forge: fzf" "$fz_block"
    ok "fzf tuned"
  fi

  # --- 5. trim leftover nerd-font faces (fonts step prunes on install) ---
  tf_prune_fonts

  # --- 6. Ctrl-R history search ---
  # atuin's keyring is dead on Android, so bind Ctrl-R to whichever works
  if ask_yn "Bind Ctrl-R to history search (fzf)?" "Y"; then
    if command -v atuin >/dev/null && atuin history list >/dev/null 2>&1; then
      zshrc_append "termux-forge: ctrl-r" 'atuin_bind_ctrl_r() {
  local sel
  sel=$(atuin search --interactive --bind "ctrl-r:accept")
  [[ -n "$sel" ]] && print -z "$sel"
}
zle -N atuin_bind_ctrl_r
bindkey "^R" atuin_bind_ctrl_r'
      ok "Ctrl-R bound to atuin"
    else
      zshrc_append "termux-forge: ctrl-r" '_tf_hist_pick() {
  local sel
  sel=$(fc -ln -r -3000 2>/dev/null | tac | grep -v "^[[:space:]]*$" \
        | fzf --height=60% --border=rounded --info=inline --prompt="history> " \
              --color=border:#88c0d0,prompt:#a3be8c,pointer:#bf616a)
  [[ -n "$sel" ]] && print -z -- "$sel"
}
zle -N _tf_hist_pick
bindkey "^R" _tf_hist_pick'
      ok "Ctrl-R bound to zsh history via fzf (atuin keyring unavailable)"
    fi
  fi

  # --- 7. goon: the terminal reacting to what you actually run ---
  if ask_yn "Goon mode — per-command timing, exit feedback, load-reactive hue?" "Y"; then
    zshrc_append "termux-forge: goon" '(( $+functions[add-zsh-hook] )) || autoload -Uz add-zsh-hook
typeset -g _tf_goon=1 _tf_hue=0 _tf_t0=""
typeset -ga _tf_gl=(✦ ✧ ⟡ ◈ ❋ ✺ ⚡ ⋆ ✷ ⟁)

# Load average for the hue. Must not fork on the hot path: a $(...) command
# substitution spawns a subshell on EVERY prompt, which is real latency on a
# phone. So this sets a variable, and the hook reads the variable directly.
_tf_load_refresh() {
  local u
  u="$(uptime 2>/dev/null)"
  _tf_load_cache="${${u##*average: }%%,*}"
  _tf_load_at=$EPOCHSECONDS
}
_tf_load() { (( EPOCHSECONDS - ${_tf_load_at:-0} > 5 )) && _tf_load_refresh; }

_tf_goon_pre() { _tf_t0=$EPOCHREALTIME }

_tf_goon_post() {
  local code=$? dt="" g hue dstr load
  (( _tf_goon )) || return 0
  [[ -n "$_tf_t0" ]] || return 0          # bare Enter: nothing ran
  dt=$(( EPOCHREALTIME - _tf_t0 ))        # no (( )): that truncates floats
  _tf_t0=""
  # hue drifts by load so the prompt mirrors how busy the box is
  _tf_load
  load="${_tf_load_cache:-0}"
  hue=$(( (_tf_hue + 11 + ${load:-0} * 3) % 256 ))
  (( _tf_hue = hue ))
  g=${_tf_gl[RANDOM % ${#_tf_gl}]}
  dstr=$(printf "%.2fs" "$dt")             # %.2f inside print -P would eat %f
  if (( code == 0 )); then
    print -P "%F{38;5;$hue}  $g%f  %F{8}$dstr%f"
  else
    print -P "%F{196}  ✗ ${code}%f  %F{8}$dstr%f"
  fi
}
add-zsh-hook preexec _tf_goon_pre
add-zsh-hook precmd  _tf_goon_post

# tfgo <name> — full-screen animation on demand
tfgo() { command tfloop "$@" 2>/dev/null || command tfloop plasma; }'
    ok "goon mode wired (tfgo plays animations)"
  fi

  ok "polish applied"
}

step_commands() {
  backup pre-commands "$PREFIX/bin/tfart" "$PREFIX/bin/reveal" "$PREFIX/bin/setname" \
    "$PREFIX/bin/tf-style-preview" "$PREFIX/bin/ftext" "$PREFIX/bin/findbig" "$PREFIX/bin/peek" "$PREFIX/bin/scrub"
  local c
  for c in tfart tf-style-preview tfloop tf-prompt-preview tf-theme-preview tf-keys-preview tf-font-preview reveal setname ftext findbig peek scrub; do
    run "cp '$SCRIPT_DIR/commands/$c' '$PREFIX/bin/$c' && chmod +x '$PREFIX/bin/$c'"
    ok "installed: $c"
  done
  ok "helper commands ready"
}

step_finish() {
  run "termux-reload-settings"
  echo
  printf '%s%s%s\n' "${C[bold]}${C[green]}" "All done." "${C[reset]}"
  hr
  info "state:    $STATE_DIR/session"
  info "backups:  $BACKUP_DIR"
  info "logs:     $LOG_FILE"
  info "restore:  tar xzf <backup>.tar.gz -C \$HOME"
  hr

  # Make the CURRENT terminal show the new colours/font instead of waiting for
  # the next launch: colors apply live, fonts need a restart, .zshrc needs a
  # re-exec.
  echo
  printf '  %s▚%s %stake effect now%s\n' "${C[cyan]}" "${C[reset]}" "${C[bold]}" "${C[reset]}"
  if ((YES)); then
    info "colours reloaded · run 'exec zsh' for the new prompt/font"
  else
    if ask_yn "Re-exec zsh now so the prompt/font/banner show up?" "Y"; then
      # termux-reload-settings already pushed colors; re-exec picks up .zshrc
      printf '\n  %s▚%s restarting shell — nothing is lost, your history survives\n' "${C[cyan]}" "${C[reset]}"
      exec "${SHELL:-/data/data/com.termux/files/usr/bin/zsh}" -l
    else
      info "run 'exec zsh' whenever you want the new prompt"
    fi
  fi

  if ((YES)); then
    :
  elif ((NO)); then
    info "skip tf install"
  else
    echo
    if ask_yn "Install as 'tf' in $PREFIX/bin for quick access?" "Y"; then
      run "rm -f '$PREFIX/bin/tf' && ln -s '$SCRIPT_DIR/$(basename "$_tf_self")' '$PREFIX/bin/tf'"
      ok "installed — run 'tf' anytime (symlink, always current)"
    else
      info "skip — run $_tf_self instead"
    fi
  fi
}

# --------------------------------------------------------------------------
# Orchestrator
# --------------------------------------------------------------------------
# Each step gets a stable accent hue derived from its position, so consecutive
# steps never look alike and you always know where you are.
step_accent() {
  local id="$1" i=0 s
  for s in "${STEPS[@]}"; do (( i++ )); [[ "$s" == "$id" ]] && break; done
  (( i == 0 )) && i=1
  STEP_HUE=$(( (i * 47 + 30) % 256 ))
  STEP_IDX=$i
}

confirm_step() {
  local id="$1" st
  st="$(state_get "$id")"
  if [[ "$st" == "done" && "$FORCE" != "1" ]]; then
    return 1
  fi
  if [[ ",$SKIP_LIST," == *",$id,"* ]]; then
    info "[$id] skipped via --skip"
    state_set "$id" skipped
    return 1
  fi
  if [[ -n "$ONLY_LIST" && ",$ONLY_LIST," != *",$id,"* ]]; then
    return 1
  fi

  # destructive steps never run in a normal pass — they must be named explicitly
  case "$id" in
    cleanup|repair)
      if [[ -n "$ONLY_LIST" || "$OPT_IN" == "1" ]]; then
        warn "opt-in step [$id] — this deletes things"
      else
        info "[$id] is opt-in (deletes things) — run: tf --only $id"
        return 1
      fi
      ;;
  esac

  step_accent "$id"
  if [[ -n "$ONLY_LIST" ]] || [[ "$st" == done && "$FORCE" == 1 ]]; then
    step_head "$id"          # quieter: user already chose this step
  else
    step_confirm_card "$id"    # full card before asking
  fi

  if ((YES)); then return 0; fi
  if ((NO)); then state_set "$id" skipped; return 1; fi
  ask_yn "Run this step?" "Y" || { state_set "$id" skipped; info "skipped"; return 1; }
  return 0
}

# Compact: a bar and a counter, not twenty lines of step list repeated before
# every step. The full list is one keystroke away (--verbose) or shown at the
# end as a summary.
show_progress() {
  local id="$1" total="${#STEPS[@]}" idx=0 s
  local width=28 filled i bar
  for s in "${STEPS[@]}"; do (( idx++ )); [[ "$s" == "$id" ]] && break; done
  filled=$(( idx * width / total ))
  bar=""
  for ((i = 0; i < width; i++)); do
    if   (( i < filled )); then bar+=$'\033[38;5;42m\u2588\033[0m'
    elif (( i == filled )); then bar+=$'\033[38;5;51m\u2593\033[0m'
    else bar+=$'\033[38;5;238m\u2591\033[0m'; fi
  done
  printf '\n  %b%s%b  %s%d%s/%s%d%s  %s%s%s\n' \
    "\033[38;5;${STEP_HUE}m" "$bar" '\033[0m' \
    "${C[bold]}" "$idx" "${C[reset]}" "${C[dim]}" "$total" "${C[reset]}" \
    "${C[dim]}" "${STEP_NAME[$id]}" "${C[reset]}"

  if [[ "$VERBOSE" == "1" ]]; then show_progress_full "$id"; fi
}

show_progress_full() {
  local current="$1" id st sym
  echo
  for id in "${STEPS[@]}"; do
    st="$(state_get "$id")"
    case "$st" in
      done)    sym=$'\033[38;5;42m\u2713\033[0m' ;;
      failed)  sym=$'\033[38;5;203m\u2717\033[0m' ;;
      skipped) sym=$'\033[38;5;244m\u2014\033[0m' ;;
      *)       sym=$'\033[38;5;240m\u25cb\033[0m' ;;
    esac
    if [[ "$id" == "$current" ]]; then
      printf '  \033[38;5;51m\u25b8\033[0m %s%-11s\033[0m %s\033[1m%s\033[0m\n' \
        "$id" "${STEP_NAME[$id]}"
    else
      printf '  %s %s%-11s\033[0m %s\033[2m%s\033[0m\n' \
        "$sym" "${C[dim]}" "$id" "${C[reset]}" "${STEP_NAME[$id]}"
    fi
  done
}

run_step() {
  local id="$1" t0 t1 rc
  confirm_step "$id" || return 0
  show_progress "$id"
  t0="$(date +%s)"
  "step_$id"; rc=$?
  t1="$(date +%s)"
  if (( rc == 0 )); then
    state_set "$id" done
    ok "[$id] done in $((t1 - t0))s"
    return 0
  fi
  if (( rc == 2 )) || (( TF_QUIT )); then
    state_set "$id" cancelled
    warn "[$id] cancelled — stopping"
    return 2
  fi
  state_set "$id" failed
  err "[$id] FAILED after $((t1 - t0))s"
  return 1
}

list_steps() {
  printf '  %s%-12s %s%s\n' "${C[yellow]}" "ID" "${C[reset]}" "${C[bold]}NAME${C[reset]}"
  hr
  local id
  for id in "${STEPS[@]}"; do
    printf '  %s%-12s%s %s\n' "${C[cyan]}" "$id" "${C[reset]}" "${STEP_NAME[$id]}"
  done
  hr
  echo
  info "run: $_tf_self --only <ids> to run a subset"
}

tf_flush() {
  header
  local nb nl
  nb="$(find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' 2>/dev/null | wc -l)"
  nl="$(find "$LOG_DIR" -maxdepth 1 -name '*.log' 2>/dev/null | wc -l)"
  printf '  %sThis deletes:%s\n' "${C[bold]}" "${C[reset]}"
  printf '    %s backups (%s tarballs in %s)\n' "${C[red]}" "$nb" "$BACKUP_DIR"
  printf '    %s logs   (%s files in %s)\n' "${C[red]}" "$nl" "$LOG_DIR"
  printf '    %s state  (%s)\n' "${C[red]}" "$STATE_DIR/session"
  echo
  if ((YES)); then :
  elif ((NO)); then info "flush cancelled"; return 1
  else
    ask_yn "Delete all of the above and start fresh?" "N" || { info "flush cancelled"; return 1; }
  fi
  if ((DRY_RUN)); then
    printf '  %s$%s rm -rf %s/* %s/* session\n' "${C[dim]}" "${C[reset]}" "$BACKUP_DIR" "$LOG_DIR"
    ok "would flush — every step would run again"
    return 0
  fi
  rm -rf "${BACKUP_DIR:?}"/* "${LOG_DIR:?}"/* "$STATE_DIR/session" 2>/dev/null || true
  ok "flushed — every step will run again"
}

main() {
  header
  if ((LIST)); then list_steps; exit 0; fi
  if ((FLUSH)); then tf_flush; exit 0; fi
  if ((RESET)); then rm -f "$STATE_DIR/session"; info "session reset (state only; use --flush for everything)"; fi

  printf '  %s▸%s %sstate%s %s%s%s %s▸%s %sbackup%s %s%s%s %s▸%s %slog%s %s%s%s\n' \
    "${C[dim]}" "${C[reset]}" "${C[dim]}" "${C[reset]}" "${C[cyan]}" "$STATE_DIR" "${C[reset]}" \
    "${C[dim]}" "${C[reset]}" "${C[dim]}" "${C[reset]}" "${C[cyan]}" "$BACKUP_DIR" "${C[reset]}" \
    "${C[dim]}" "${C[reset]}" "${C[dim]}" "${C[reset]}" "${C[cyan]}" "$(basename "$LOG_FILE")" "${C[reset]}"
  if ((DRY_RUN)); then warn "DRY RUN — nothing will change"; fi
  echo

  local id rc failed=0 skipped=()
  for id in "${STEPS[@]}"; do
    run_step "$id"; rc=$?
    if (( rc == 2 )); then break; fi
    (( rc )) && { failed=$((failed + 1)); err "stopping after failure in [$id] — fix it, then: tf --only $id --force"; break; }
  done
  if [[ ${#skipped[@]} -gt 0 ]]; then
    printf '\n  %s▏%s skipped %s — run with --force to include: %s%s%s\n' \
      "${C[dim]}" "${C[reset]}" "${#skipped[@]}" "${C[yellow]}" "${skipped[*]}" "${C[reset]}"
  fi
  run_summary
  (( failed )) && return 1
  return 0
}

# Because each step clears the screen, scrollback is worthless by the end. This
# is the one screen worth keeping.
run_summary() {
  local id st n_done=0 n_skip=0 n_fail=0 n_todo=0
  local -a SYM_DONE SYM_FAIL SYM_SKIP SYM_TODO
  SYM_DONE=$'\033[38;5;42m\xe2\x9c\x93\033[0m'
  SYM_FAIL=$'\033[38;5;203m\xe2\x9c\x97\033[0m'
  SYM_SKIP=$'\033[38;5;244m\xe2\x80\x94\033[0m'
  SYM_TODO=$'\033[38;5;240m\xe2\x97\x8b\033[0m'

  if [[ -t 1 && "$DRY_RUN" -eq 0 ]]; then printf '\033[H\033[2J\033[3J'; fi
  printf '\n  %s%s%s\n' "${C[dim]}" "$RULE58" "${C[reset]}"
  printf '  %s%sRUN SUMMARY%s\n\n' "${C[bold]}" "${C[cyan]}" "${C[reset]}"

  for id in "${STEPS[@]}"; do
    st="$(state_get "$id")"
    case "$st" in
      done)    sym="$SYM_DONE";  n_done=$(( n_done + 1 )) ;;
      failed)  sym="$SYM_FAIL";  n_fail=$(( n_fail + 1 )) ;;
      skipped) sym="$SYM_SKIP";  n_skip=$(( n_skip + 1 )) ;;
      *)       sym="$SYM_TODO";  n_todo=$(( n_todo + 1 )) ;;
    esac
    printf '   %s %s%-11s%s %s\x1b[2m%s\x1b[0m\n' \
      "$sym" "${C[dim]}" "$id" "${C[reset]}" "${C[dim]}" "${STEP_NAME[$id]}"
  done

  printf '\n  %s%d done \xc2\xb7 %d skipped \xc2\xb7 %d failed \xc2\xb7 %d not run%s\n' \
    "${C[dim]}" "$n_done" "$n_skip" "$n_fail" "$n_todo" "${C[reset]}"
  printf '  %s%s%s\n' "${C[dim]}" "$RULE58" "${C[reset]}"
  printf '\n'
}

main "$@"
