kb_center() {
  local text="$1" width="$2"
  local pad=$(( width - ${#text} ))
  local left=$(( pad / 2 ))
  local right=$(( pad - left ))
  printf '%*s%s%*s' "$left" "" "$text" "$right" ""
}

kb_render_row() {
  local -a keys=("$@")
  if ((${#keys[@]} == 0 )); then
    printf '  %s(empty row)%s\n' "${C[dim]}" "${C[reset]}"
    return
  fi
  local top="┌" mid="" bot="└" k cell
  for k in "${keys[@]}"; do
    cell="$(kb_center "$k" 6)"
    top+="───────┬"
    mid+="│${cell}"
    bot+="───────┴"
  done
  top="${top%┬}┐"
  mid+="│"
  bot="${bot%┴}┘"
  printf '  %s%s%s\n' "${C[cyan]}" "$top" "${C[reset]}"
  printf '  %s%s%s\n' "${C[cyan]}" "$mid" "${C[reset]}"
  printf '  %s%s%s\n' "${C[cyan]}" "$bot" "${C[reset]}"
}

kb_render_all() {
  local r
  for r in "${KB_ROWS[@]}"; do
    kb_render_row $r
    echo
  done
}

# Keep only the four faces the font picker offers. Installs unpack the whole
# family; without this the machine carries ~200MB of faces nothing will ever
# select, which is exactly what the old "install now, prune in a later step"
# arrangement did.
tf_prune_fonts() {
  local keep="MesloLGSNerdFont-Bold.ttf MesloLGSNerdFont-Regular.ttf \
MesloLGSNerdFontMono-Bold.ttf MesloLGSNerdFontMono-Regular.ttf"
  local f base before after dropped=0
  before="$(du -sh "$HOME/.fonts" 2>/dev/null | cut -f1)"
  for f in "$HOME/.fonts"/*NerdFont*.ttf; do
    [[ -f "$f" ]] || continue
    base="$(basename "$f")"
    case " $keep " in *" $base "*) continue ;; esac
    rm -f "$f" && (( dropped++ ))
  done
  (( dropped )) || return 0
  after="$(du -sh "$HOME/.fonts" 2>/dev/null | cut -f1)"
  info "fonts: $before -> $after (dropped $dropped unused faces)"
}

kb_template() {
  # KB_EXTRA_KEYS, when set, replaces the generated rows verbatim — some
  # layouts need per-key popups and macros that a row list cannot express.
  KB_EXTRA_KEYS=""
  case "$1" in
    1) KB_ROWS=("ESC CTRL ALT TAB KEYBOARD HOME UP END" "DELETE {} () [] BACKSLASH LEFT DOWN RIGHT") ;;
    2) KB_ROWS=("ESC CTRL ALT TAB KEYBOARD" "DELETE HOME UP END LEFT DOWN RIGHT") ;;
    3) KB_ROWS=("ESC CTRL ALT TAB KEYBOARD HOME UP END PGUP" "DELETE {} () [] BACKSLASH LEFT DOWN RIGHT PGDN") ;;
    4) KB_ROWS=("ESC CTRL ALT TAB" "LEFT DOWN UP RIGHT") ;;
    5) KB_ROWS=()
       KB_EXTRA_KEYS=$(cat <<'TOPKEYS'
extra-keys = [[ \
  {key: ESC, popup: {macro: "CTRL f d", display: "tmux exit"}}, \
  {key: CTRL, popup: {macro: "CTRL f BKSP", display: "tmux ←"}}, \
  {key: ALT, popup: {macro: "CTRL f TAB", display: "tmux →"}}, \
  {key: TAB, popup: {macro: "ALT a", display: A-a}}, \
  {key: LEFT, popup: HOME}, \
  {key: DOWN, popup: PGDN}, \
  {key: UP, popup: PGUP}, \
  {key: RIGHT, popup: END}, \
  {macro: "ALT j", display: A-j, popup: {macro: "ALT g", display: z-g}}, \
  {key: KEYBOARD, popup: {macro: "CTRL d", display: exit}} \
]]
TOPKEYS
)
       ;;
    6) KB_ROWS=("ESC CTRL ALT TAB KEYBOARD" "H J K L LEFT RIGHT" "SHIFT SPACE ENTER DELETE") ;;
    7) KB_ROWS=("ESC CTRL ALT TAB KEYBOARD" "LEFT RIGHT HOME END") ;;
    *) KB_ROWS=("ESC CTRL ALT TAB" "LEFT DOWN UP RIGHT") ;;
  esac
}

KB_KEYS=(ESC CTRL ALT TAB SHIFT META HOME END PGUP PGDN UP DOWN LEFT RIGHT DELETE BACKSPACE ENTER KEYBOARD DRAWER SPACE)

kb_key_menu() {
  ask_menu "Choose a key:" 1 \
    "ESC" "CTRL" "ALT" "TAB" "SHIFT" "META" \
    "HOME" "END" "PGUP" "PGDN" "UP" "DOWN" "LEFT" "RIGHT" \
    "DELETE" "BACKSPACE" "ENTER" "KEYBOARD" "DRAWER" "SPACE" "Custom (type any)"
  local idx="$MENU_CHOICE"
  if (( idx == 21 )); then
    KB_KEY="$(ask_input "Key name (e.g. F1, F2, _)" "F1")"
  else
    KB_KEY="${KB_KEYS[$((idx - 1))]}"
  fi
}

kb_custom_builder() {
  local -a rows=()
  local nrows
  nrows="$(ask_input "How many rows? (1-4)" "2")"
  nrows="${nrows:-2}"
  [[ "$nrows" =~ ^[0-9]+$ ]] || nrows=2
  (( nrows < 1 )) && nrows=1
  (( nrows > 4 )) && nrows=4

  local ri=0
  local -a row=()
  while (( ri < nrows )); do
    while :; do
      echo
      printf '  %sRow %d/%d%s\n' "${C[bold]}" "$((ri + 1))" "$nrows" "${C[reset]}"
      kb_render_row "${row[@]}"
      ask_menu "Row $((ri + 1)) — add keys, then continue:" 1 \
        "Add a key" "Remove last key" "Done with this row →" "← Back to previous row" "Cancel"
      case "$MENU_CHOICE" in
        1)
          kb_key_menu
          row+=("$KB_KEY")
          ;;
        2)
          ((${#row[@]} > 0 )) && unset 'row[-1]'
          ;;
        3)
          if ((${#row[@]} == 0 )); then
            warn "row is empty — add at least one key"
          else
            rows+=("$(printf '%s ' "${row[@]}")")
            row=()
            ((ri++))
            break
          fi
          ;;
        4)
          if ((${#rows[@]} > 0 )); then
            row=(${rows[-1]})
            unset 'rows[-1]'
            ((ri--))
          else
            info "already at the first row"
          fi
          break
          ;;
        5)
          return 1
          ;;
      esac
    done
  done
  KB_ROWS=("${rows[@]}")
  return 0
}

step_keyboard() {
  local f="$HOME/.termux/termux.properties"

  section "keyboard" "Current setup"
  if [[ -f "$f" ]] && grep -q 'extra-keys' "$f"; then
    info "current extra-keys:"
    grep 'extra-keys' "$f" | sed 's/^/    /'
  else
    info "no extra-keys configured — using Termux default"
  fi
  echo

  ask_menu "How do you want to configure the keyboard?" 1 \
    "Use a template (preview each one)" \
    "Build custom — row by row, key by key" \
    "Keep current"
  local mode="$MENU_CHOICE"

  if [[ "$mode" == "3" ]]; then
    ok "keeping current keyboard"
    return 0
  fi

  if [[ "$mode" == "1" ]]; then
    # preview pane shows the keymap before you pick — always
    local -a tpl=(
      "3-row classic — ESC CTRL ALT TAB / HOME UP END / DELETE {} () [] BACKSLASH LEFT DOWN RIGHT"
      "2-row compact — ESC CTRL ALT TAB / DELETE HOME UP END LEFT DOWN RIGHT"
      "4-row full — adds PGUP PGDN"
      "Minimal — ESC CTRL ALT TAB / LEFT DOWN UP RIGHT"
      "Gaming — arrows + SHIFT SPACE ENTER DELETE"
      "Vim — H J K L + arrows"
      "TOP / tmux — ESC CTRL ALT TAB KEYBOARD / LEFT RIGHT HOME END"
    )
    tf_pick "Keyboard template? (preview below)" "keys" 1 "${tpl[@]}" \
      || { err "cancelled"; return 1; }
    kb_template "$MENU_CHOICE"
  else
    if ! kb_custom_builder; then
      err "keyboard builder cancelled"
      return 1
    fi
  fi

  backup pre-keyboard "$HOME/.termux/termux.properties"

  echo
  printf '  %sPreview:%s\n' "${C[bold]}" "${C[reset]}"
  kb_render_all

  if ! ((YES)); then
    ask_yn "Apply this layout?" "Y" || { err "aborted"; return 1; }
  fi

  local props
  if [[ -n "$KB_EXTRA_KEYS" ]]; then
    # verbatim layout — do not reformat, popup macros depend on exact spacing
    props="# Generated by termux-forge"$'\n'"$KB_EXTRA_KEYS"$'\n'
  else
    local -a rowlines=()
    local r
    for r in "${KB_ROWS[@]}"; do
      local keys="" k
      for k in $r; do keys+="'$k', "; done
      keys="${keys%, }"
      rowlines+=("    [$keys]")
    done
    local joined="" i
    for i in "${!rowlines[@]}"; do
      if (( i < ${#rowlines[@]} - 1 )); then
        joined+="${rowlines[$i]}, \\"$'\n'
      else
        joined+="${rowlines[$i]} \\"
      fi
    done
    props="# Generated by termux-forge"$'\n'"extra-keys = [ \\"$'\n'"${joined}"$'\n'
    props+="]"$'\n'
  fi
  props+="allow-external-apps = true"$'\n'"shortcut.create-session = ctrl + t"$'\n'"shortcut.next-session = ctrl + 2"$'\n'"shortcut.previous-session = ctrl + 1"$'\n'"shortcut.rename-session = ctrl + u"$'\n'"terminal-cursor-blink-rate=600"

  emit "$f" <<EOF
$props
EOF
  run "termux-reload-settings"
  ok "keyboard layout applied"
}

