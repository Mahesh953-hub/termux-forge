# --------------------------------------------------------------------------
# Step: preflight
# --------------------------------------------------------------------------
step_preflight() {
  info "PREFIX      = ${PREFIX:-<unset>}"
  info "HOME        = $HOME"
  info "arch        = $(uname -m)"
  info "shell       = $SHELL"
  info "zsh         = $(command -v zsh || echo missing)"
  info "pkg         = $(command -v pkg || echo missing)"
  info "dialog      = $(command -v dialog || echo missing)"
  info "storage     = $([[ -d /sdcard ]] && echo granted || echo 'not granted')"
  info "termux-nf   = $(command -v termux-nf || echo missing)"
  info "termux-color= $(command -v termux-color || echo missing)"

  [[ -n "${PREFIX:-}" ]] || { err "PREFIX is unset — are you inside Termux?"; return 1; }
  command -v pkg >/dev/null || { err "pkg not found"; return 1; }

  if ! ping -c 1 -W 3 8.8.8.8 >/dev/null 2>&1; then
    warn "network unreachable — install steps will fail"
    ask_yn "Continue anyway?" "N" || return 1
  fi
  ok "preflight passed"
}

# --------------------------------------------------------------------------
# Step: backup
# --------------------------------------------------------------------------
step_backup() {
  backup dotfiles \
    "$HOME/.zshrc" "$HOME/.zshenv" "$HOME/.p10k.zsh" "$HOME/.bashrc" \
    "$HOME/.nanorc" "$HOME/.termux" "$HOME/motd.sh" "$HOME/ninja.sh" \
    "$HOME/.config/fastfetch" "$HOME/.profile"
}

# --------------------------------------------------------------------------
# Step: packages
# --------------------------------------------------------------------------
step_packages() {
  pkg_install zsh git curl wget ripgrep fzf fd bat eza zoxide atuin \
    neovim fastfetch jq python3 ncurses-utils openssl dialog tar unzip
  ok "packages installed"
}

# --------------------------------------------------------------------------
# Step: zsh
# --------------------------------------------------------------------------
step_zsh() {
  command -v zsh >/dev/null || pkg_install zsh
  local current
  current="$(getent passwd "$USER" 2>/dev/null | cut -d: -f7)"
  info "current login shell: ${current:-unknown}"
  if [[ "$current" == */zsh && "$FORCE" != "1" ]]; then
    ok "zsh already the login shell"
    return 0
  fi
  run "chsh -s zsh"
  ok "login shell set to zsh"
}

# --------------------------------------------------------------------------
# Step: oh-my-zsh
# --------------------------------------------------------------------------
step_omz() {
  if [[ -d "$HOME/.oh-my-zsh/.git" && "$FORCE" != "1" ]]; then
    info "oh-my-zsh already installed"
    ask_yn "Reinstall it?" "N" || return 0
    run "rm -rf '$HOME/.oh-my-zsh'"
  fi
  backup pre-omz "$HOME/.zshrc" "$HOME/.zshenv"
  run "sh -c \"\$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)\" --unattended"
  [[ -d "$HOME/.oh-my-zsh" ]] || { err "oh-my-zsh install failed"; return 1; }
  ok "oh-my-zsh installed"
}

