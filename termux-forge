STEP_EXPLAIN[commands]="Copies the bundled helper scripts into $PREFIX/bin so you can run them from anywhere: tfart (switch ASCII art), reveal (network info), setname (set banner username), ftext (fast text search), findbig (find large files), peek (preview a file), scrub (clean cache)."
